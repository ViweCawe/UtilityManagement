@page
@model UtilityManagerProjects.Pages.WaterBalance.IndexModel
@{ ViewData["Title"]="Water movement and storage"; }
@section Styles {<link rel="stylesheet" href="~/css/station-water-flow.css" asp-append-version="true"/>}
<div class="page-shell">
    <div class="page-header-row"><div class="page-title"><h1>Water movement and storage</h1><p>Track tank stock, transfers and final consumption separately.</p></div>@if(User.IsInRole("Admin")){<a asp-page="/WaterNetwork/Edit" class="utility-btn-secondary">Configure tank boundaries</a>}</div>
    @if(ViewData["DateNotice"] is string notice){<p class="alert alert-info">@notice</p>}
    <form method="get" class="dashboard-filter-card"><div class="filter-group"><label asp-for="StartDate">From</label><input asp-for="StartDate" type="date" class="utility-input"/></div><div class="filter-group"><label asp-for="EndDate">Through</label><input asp-for="EndDate" type="date" class="utility-input"/></div><button class="utility-btn-primary" type="submit">Apply dates</button></form>
    <section class="stats-grid stats-grid-4">
        <div class="stat-card"><div class="stat-content"><p>Municipal water received</p><h2>@(Model.Flow.MunicipalReceipt.CoveredDays>0?Model.Flow.MunicipalReceipt.Total.ToString("N1")+" L":"Not recorded")</h2><span>Separate physical inlet; no volume inferred from Main</span></div></div>
        <div class="stat-card"><div class="stat-content"><p>Main outlet · water released</p><h2>@(Model.Flow.Water.CoveredDays>0?Model.Flow.Water.Total.ToString("N1")+" L":"Unknown")</h2><span>Includes transfers · @Model.Flow.Water.CoveredDays days covered</span></div></div>
        <div class="stat-card"><div class="stat-content"><p>Recorded final consumption</p><h2>@(Model.EndUse.Scope.IsComplete?Model.EndUse.Scope.Total.ToString("N1")+" L":"Not fully measured")</h2><span>Confirmed final-use meters only</span></div></div>
        <div class="stat-card"><div class="stat-content"><p>Calculable tank balances</p><h2>@Model.Report.Balances.Count(b=>b.CalculatedStock.HasValue) / @Model.Report.Balances.Count</h2><span>Missing flow or stock stays unknown</span></div></div>
    </section>
    <section class="content-card" aria-label="Tank balances">
        <div class="content-card-header"><div><h2>Tank balances</h2><p>Opening stock + water received − water leaving = closing stock. Water leaving a tank may be a transfer to the next tank.</p></div></div>
        <div class="table-wrap"><table class="utility-table tank-balance-table">
            <thead><tr><th>Tank</th><th>Opening stock</th><th>Water received</th><th>Water leaving</th><th>Closing stock</th></tr></thead>
            <tbody>
                @foreach(var row in Model.Report.Balances)
                {
                    <tr data-tank-balance="@row.NodeId"><td><strong>@row.Name</strong><details><summary>Calculation details</summary><p>@row.Status</p>@if(row.OpeningVolume.HasValue){<p>Measured anchor: @row.OpeningVolume.Value.ToString("N1") L at end of @row.OpeningDate?.ToString("dd MMM yyyy").</p>}</details></td><td>@(row.PeriodOpeningStock.HasValue?row.PeriodOpeningStock.Value.ToString("N1")+" L":"Unknown")</td><td>@(row.PeriodInflow.HasValue?row.PeriodInflow.Value.ToString("N1")+" L":"Unknown")</td><td>@(row.PeriodOutflow.HasValue?row.PeriodOutflow.Value.ToString("N1")+" L":"Unknown")</td><td><strong>@(row.CalculatedStock.HasValue?row.CalculatedStock.Value.ToString("N1")+" L":"Unknown")</strong></td></tr>
                }
            </tbody>
        </table></div>
        <p class="form-hint">Opening stock is at the start of the selected dates; closing stock is at the selected end date. A physical opening measurement and complete inlet/outlet coverage are required. Source closing stock remains unknown while the municipal inlet is not recorded. Counter readings measure movement, not tank levels.</p>
    </section>
    <partial name="_WaterConsumptionTable" model="Model.EndUse" />
    <section class="content-card"><partial name="_BoreholeFlow" model="Model.Trace.Borehole" /></section>
    <partial name="_StationWaterFlow" model="Model.Trace" />
    <details class="content-card"><summary>Paired internal tank transfers</summary><p>A shared transfer counter debits the supplying tank and credits the receiving tank. It is not extra consumption.</p><div class="table-wrap"><table class="utility-table"><thead><tr><th>From</th><th>To</th><th>Transfer counter</th><th>Recorded transfer</th></tr></thead><tbody>
        @foreach(var row in Model.Report.Transfers){<tr><td>@row.From</td><td>@row.To</td><td>@row.MeterName</td><td>@(row.Volume.HasValue?row.Volume.Value.ToString("N1")+" L":"Awaiting comparable readings")</td></tr>}
        @if(Model.Report.Transfers.Count==0){<tr><td colspan="4">Configure the same actual counter as the supplying tank’s outlet and receiving tank’s inlet where it measures that physical transfer.</td></tr>}
    </tbody></table></div></details>
</div>
@section Scripts {<script type="module" src="~/js/station-water-flow.js" asp-append-version="true"></script>}
