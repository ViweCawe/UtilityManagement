@page
@model UtilityManagerProjects.Pages.Admin.UserManagement.EditRolesModel

@{
    ViewData["Title"] = "Manage User Roles";
}

<div class="page-shell">

    <div class="page-header-row">
        <div class="page-title">
            <h1>Manage User Roles</h1>
            <p>Assign or remove roles for @Model.UserEmail.</p>
        </div>

        <div class="page-actions">
            <a class="utility-btn-secondary"
               asp-page="./Index">
                <i class="bi bi-arrow-left"></i>
                Back to User Manager
            </a>
        </div>
    </div>

    <section class="content-card user-role-edit-card">
        <div class="content-card-header">
            <div>
                <h3>@Model.UserEmail</h3>
                <p>Select every role this user should have.</p>
            </div>

            <div class="stat-icon blue">
                <i class="bi bi-person-gear"></i>
            </div>
        </div>

        <form method="post" class="utility-form">
            <input type="hidden" asp-for="UserId" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"></div>

            <div class="role-checkbox-grid">
                @for (var index = 0;
                      index < Model.RoleSelections.Count;
                      index++)
                {
                    <label class="role-checkbox-card">
                        <input type="hidden"
                               asp-for="RoleSelections[index].RoleName" />

                        <input asp-for="RoleSelections[index].IsSelected" />

                        <span class="role-checkbox-icon">
                            <i class="bi bi-shield-check"></i>
                        </span>

                        <span>
                            <strong>
                                @Model.RoleSelections[index].RoleName
                            </strong>
                            <small>
                                Grant access associated with this role
                            </small>
                        </span>
                    </label>
                }
            </div>

            <div class="form-actions">
                <button type="submit"
                        class="utility-btn-primary">
                    <i class="bi bi-check-lg"></i>
                    Save Role Assignments
                </button>

                <a asp-page="./Index"
                   class="utility-btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
