@page
@model UtilityManagerProjects.Pages.Reports.IndexModel

@{
    ViewData["Title"] = "Reports";
}

<div class="page-shell">

    <div class="page-header-row">
        <div class="page-title">
            <h1>Reports</h1>
            <p>Generate and review utility management reports.</p>
        </div>

        <div class="page-actions">
            <a class="utility-btn-secondary" href="#">
                <i class="bi bi-filetype-pdf"></i>
                PDF
            </a>

            <a class="utility-btn-primary" href="#">
                <i class="bi bi-download"></i>
                Export Report
            </a>
        </div>
    </div>

    <section class="stats-grid stats-grid-3">

        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-droplet-fill"></i>
            </div>
            <div class="stat-content">
                <p>Water Total</p>
                <h2>@Model.WaterTotal.ToString("N0")</h2>
                <span>L total usage</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div class="stat-content">
                <p>Electricity Total</p>
                <h2>@Model.ElectricityTotal.ToString("N0")</h2>
                <span>kWh total usage</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon green">
                <i class="bi bi-trash3-fill"></i>
            </div>
            <div class="stat-content">
                <p>Waste Total</p>
                <h2>@Model.WasteTotal.ToString("N0")</h2>
                <span>kg total generated</span>
            </div>
        </div>

    </section>

    <section class="content-card">
        <div class="content-card-header">
            <div>
                <h3>Report Summary</h3>
                <p>Generated on @Model.GeneratedOn.ToString("dd MMM yyyy HH:mm")</p>
            </div>
        </div>

        <div class="table-wrap">
            <table class="utility-table">
                <thead>
                    <tr>
                        <th>Report Area</th>
                        <th>Total Records</th>
                        <th>Description</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Meter Readings</td>
                        <td>@Model.TotalMeterReadings.ToString("N0")</td>
                        <td>Water and electricity readings captured in the system.</td>
                    </tr>

                    <tr>
                        <td>Waste Readings</td>
                        <td>@Model.TotalWasteReadings.ToString("N0")</td>
                        <td>Waste readings captured in the system.</td>
                    </tr>

                    <tr>
                        <td>All Readings</td>
                        <td>@Model.TotalReadings.ToString("N0")</td>
                        <td>Combined utility reading records.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

</div>