@page
@model UtilityManagerProjects.Pages.Dashboard.DashboardModel
@{
}

@foreach (var kpi in Model.MeterTypeKpis)
{
    <div class="col-md-4">
        <div class="kpi-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>
                    <div class="kpi-title">
                        @kpi.
                    </div>

                    <div class="kpi-value">
                        @kpi.
                    </div>
                </div>

                       

                <div class="kpi-icon">
                    <i class="bi bi-speedometer2"></i>
                </div>

            </div>

                    

            <div class="mt-3">

                @if (kpi.WeeklyGrowthPercent >= 0)
                {
                    <span class="growth-up">
                        ▲ @kpi.WeeklyGrowthPercent.ToString("0.0")%
                    </span>
                }
                else
                {
                    <span class="growth-down">
                        ▼ @Math.Abs(kpi.WeeklyGrowthPercent).ToString("0.0")%
                    </span>
                }

                <span class="growth-text">
                    vs previous week
                </span>

            </div>

        </div>
    </div>
}