@page
@model UtilityManagerProjects.Pages.Dashboard.DashboardModel

@{
    ViewData["Title"] = "Dashboard";
    var waterLeader = Model.TopWaterAreas.FirstOrDefault();
    var electricityLeader = Model.TopElectricityAreas.FirstOrDefault();
    var waterLeaderShare = Model.WaterConsumption > 0 && waterLeader != null
        ? waterLeader.TotalUsage * 100.0 / Model.WaterConsumption
        : 0;
    var electricityLeaderShare = Model.ElectricityConsumption > 0 && electricityLeader != null
        ? electricityLeader.TotalUsage * 100.0 / Model.ElectricityConsumption
        : 0;
}

<style>
    .dashboard-page {
        --water: #2aa8ff;
        --water-soft: rgba(65, 100, 200, 0.92);
        --electricity: #f59e0b;
        --electricity-soft: rgba(245, 158, 11, 0.62);
        --success: #20b486;
        --dashboard-border: rgba(148, 163, 184, 0.2);
    }

        .dashboard-page .page-header-row,
        .dashboard-page .card-header,
        .dashboard-page .content-card-header {
            align-items: center;
        }

    .dashboard-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dashboard-pdf-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 0;
        border-radius: 10px;
        padding: 11px 16px;
        color: #fff;
        background: linear-gradient(135deg, #1d4ed8, #2563eb);
        box-shadow: 0 10px 24px rgba(37, 99, 235, 0.22);
        font-weight: 700;
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease;
    }

        .dashboard-pdf-button:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 28px rgba(37, 99, 235, 0.3);
        }

        .dashboard-pdf-button:disabled {
            cursor: wait;
            opacity: .65;
        }

    .dashboard-print-button {
        background: linear-gradient(135deg, #334155, #475569);
        box-shadow: 0 10px 24px rgba(51, 65, 85, .18);
    }

        .dashboard-print-button:hover {
            box-shadow: 0 12px 28px rgba(51, 65, 85, .26);
        }

    .dashboard-kpi-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .dashboard-page .kpi-card {
        position: relative;
        min-width: 0;
        overflow: hidden;
    }

        .dashboard-page .kpi-card::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            top: -90px;
            right: -60px;
            border-radius: 999px;
            background: var(--water-soft);
            pointer-events: none;
        }

    .dashboard-page .kpi-electricity::after {
        background: var(--electricity-soft);
    }

    .dashboard-page .kpi-coverage::after {
        background: rgba(32, 180, 134, .12);
    }

    .kpi-support {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-top: 8px;
        color: #7c8ca5;
        font-size: .78rem;
    }

    .coverage-meter {
        height: 8px;
        margin-top: 28px;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(148, 163, 184, .18);
    }

        .coverage-meter > span {
            display: block;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #14b8a6, #43d890);
        }

    .coverage-caption {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 10px;
        color: #7c8ca5;
        font-size: .78rem;
    }

    .dashboard-section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin: 28px 0 14px;
    }

        .dashboard-section-heading h2 {
            margin: 0;
            font-size: 1.08rem;
        }

        .dashboard-section-heading p {
            margin: 5px 0 0;
            color: #7c8ca5;
            font-size: .86rem;
        }

        .dashboard-section-heading span {
            color: #7c8ca5;
            font-size: .8rem;
            white-space: nowrap;
        }

    .utility-trend-grid,
    .utility-area-grid,
    .comparison-management-grid,
    .executive-insights-grid {
        display: grid;
        gap: 18px;
    }

    .utility-trend-grid,
    .utility-area-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .comparison-management-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .executive-insights-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin-top: 18px;
    }

    .dashboard-analytic-card {
        min-width: 0;
    }

    .dashboard-card-kicker {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #7c8ca5;
        font-size: .76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

        .dashboard-card-kicker::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 99px;
            background: var(--water);
        }

        .dashboard-card-kicker.electricity::before {
            background: var(--electricity);
        }

    .dashboard-card-title {
        margin-top: 4px;
    }

    .dashboard-chart-stage {
        position: relative;
        height: 310px;
        margin-top: 14px;
    }

        .dashboard-chart-stage.compact {
            height: 245px;
        }

        .dashboard-chart-stage canvas,
        .area-doughnut-stage canvas {
            width: 100% !important;
            height: 100% !important;
        }

    .area-visual-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(220px, .75fr);
        gap: 18px;
        align-items: center;
        margin-top: 14px;
    }

    .area-bar-stage {
        position: relative;
        min-height: 290px;
    }

        .area-bar-stage canvas {
            width: 100% !important;
            height: 100% !important;
        }

    .area-doughnut-stage {
        position: relative;
        height: 280px;
    }

    .area-leader-badge {
        display: inline-flex;
        align-items: center;
        max-width: 100%;
        padding: 6px 9px;
        border-radius: 999px;
        background: rgba(42, 168, 255, .51);
        color: #168477;
        font-size: .75rem;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .area-leader-badge.electricity {
            color: #b46b00;
            background: rgba(245, 208, 150, .91);
        }

    .executive-insight {
        padding: 18px;
        border: 1px solid var(--dashboard-border);
        border-radius: 14px;
        background: linear-gradient(145deg, rgba(255,255,255,.06), rgba(148,163,184,.04));
    }

        .executive-insight p {
            margin: 0;
            color: #7c8ca5;
            font-size: .78rem;
        }

        .executive-insight strong {
            display: block;
            margin-top: 7px;
            font-size: 1.1rem;
        }

        .executive-insight span {
            display: block;
            margin-top: 5px;
            color: #7c8ca5;
            font-size: .74rem;
        }

    .dashboard-page .alert-warning .alert-dot {
        background: #f59e0b;
    }

    .dashboard-export-status {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 9999;
        display: none;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: 12px;
        color: #fff;
        background: #15253b;
        box-shadow: 0 18px 40px rgba(15, 23, 42, .28);
        font-size: .86rem;
        font-weight: 700;
    }

        .dashboard-export-status.visible {
            display: flex;
        }

        .dashboard-export-status.error {
            background: #b42318;
        }

    .pdf-export-mode {
        padding: 24px !important;
        background: #f4f7fb;
    }

        .pdf-export-mode *,
        .pdf-export-mode *::before,
        .pdf-export-mode *::after {
            animation: none !important;
            transition: none !important;
        }

    @@page {
        size: A4 portrait;
        margin: 10mm;
    }

    @@media print {
        body * {
            visibility: hidden !important;
        }

        #dashboardExportSurface,
        #dashboardExportSurface * {
            visibility: visible !important;
        }

        #dashboardExportSurface {
            position: absolute;
            inset: 0 auto auto 0;
            width: 100% !important;
            padding: 0 !important;
            background: #fff !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

            #dashboardExportSurface [data-html2canvas-ignore="true"] {
                display: none !important;
            }

            #dashboardExportSurface .dashboard-kpi-grid,
            #dashboardExportSurface .utility-trend-grid,
            #dashboardExportSurface .utility-area-grid,
            #dashboardExportSurface .comparison-management-grid,
            #dashboardExportSurface .executive-insights-grid,
            #dashboardExportSurface .grid-two,
            #dashboardExportSurface .bottom-grid {
                grid-template-columns: 1fr !important;
            }

            #dashboardExportSurface .figma-card,
            #dashboardExportSurface .content-card,
            #dashboardExportSurface .stat-card,
            #dashboardExportSurface .executive-insight {
                break-inside: avoid-page;
                page-break-inside: avoid;
                box-shadow: none !important;
            }

            #dashboardExportSurface .dashboard-chart-stage {
                height: 260px;
            }

            #dashboardExportSurface .area-visual-grid {
                grid-template-columns: 1fr !important;
            }
    }

    @@media (max-width: 1200px) {
        .dashboard-kpi-grid,
        .comparison-management-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .executive-insights-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .area-visual-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 820px) {
        .dashboard-page .page-header-row,
        .dashboard-section-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .dashboard-kpi-grid,
        .utility-trend-grid,
        .utility-area-grid,
        .comparison-management-grid,
        .executive-insights-grid {
            grid-template-columns: 1fr;
        }

        .dashboard-chart-stage {
            height: 280px;
        }
    }
</style>

<div class="page-shell dashboard-page" id="dashboardExportSurface">

    <div class="page-header-row">
        <div class="page-title">
            <h1 style="color:grey">Utilities Management Dashboard</h1>
            <p>Water and electricity performance. Showing @Model.DateRangeLabel.</p>
        </div>

        <div class="dashboard-header-actions" data-html2canvas-ignore="true">
            <button type="button" class="dashboard-pdf-button" id="downloadDashboardPdfButton" onclick="downloadDashboardPdf()">
                <i class="bi bi-file-earmark-pdf-fill"></i>
                Download PDF
            </button>
            <button type="button" class="dashboard-pdf-button dashboard-print-button" id="printDashboardButton" onclick="printDashboard()">
                <i class="bi bi-printer-fill"></i>
                Print Dashboard
            </button>
        </div>
    </div>

    <form method="get" class="dashboard-filter-card" data-html2canvas-ignore="true">

        <div class="filter-group">
            <label>Date Range</label>
            <select name="DateFilter" class="utility-input" id="dashboardDateFilter">
                <option value="Last7" selected="@(Model.DateFilter == "Last7" ? "selected" : null)">Latest 7 Days</option>
                <option value="Last30" selected="@(Model.DateFilter == "Last30" ? "selected" : null)">Latest 30 Days</option>
                <option value="Custom" selected="@(Model.DateFilter == "Custom" ? "selected" : null)">Custom</option>
            </select>
        </div>

        <div class="filter-group dashboard-custom-date-filter">
            <label>Start Date</label>
            <input type="date"
                   name="StartDate"
                   value="@(Model.StartDate?.ToString("yyyy-MM-dd") ?? Model.CurrentStart.ToString("yyyy-MM-dd"))"
                   class="utility-input" />
        </div>

        <div class="filter-group dashboard-custom-date-filter">
            <label>End Date</label>
            <input type="date"
                   name="EndDate"
                   value="@(Model.EndDate?.ToString("yyyy-MM-dd") ?? Model.CurrentEnd.ToString("yyyy-MM-dd"))"
                   class="utility-input" />
        </div>

        <div class="filter-actions">
            <button type="submit" class="utility-btn-primary">
                <i class="bi bi-funnel"></i>
                Apply Filter
            </button>

            <a asp-page="./Dashboard" class="utility-btn-secondary">Clear</a>
        </div>

    </form>

    <section class="top-kpi-grid dashboard-kpi-grid">

        <div class="figma-card kpi-card kpi-water">
            <p>Water Consumption</p>
            <h2>@Model.WaterConsumption.ToString("N0") <span>L</span></h2>

            <div class="mini-trend">
                <span class="@(Model.WaterWeeklyGrowthPercent <= 0 ? "trend-positive" : "trend-negative")">
                    @(Model.WaterWeeklyGrowthPercent >= 0 ? "" : "")
                    @Math.Abs(Model.WaterWeeklyGrowthPercent).ToString("N1")%
                </span>
                <small>vs @Model.PreviousStart.ToString("dd MMM yyyy") - @Model.PreviousEnd.ToString("dd MMM yyyy")</small>
            </div>

            <canvas id="waterMiniChart"></canvas>
            <div class="kpi-support">
                <span>Daily average</span>
                <strong>@Model.AverageDailyWater.ToString("N0") L</strong>
            </div>
        </div>

        <div class="figma-card kpi-card kpi-electricity">
            <p>Electricity Consumption</p>
            <h2>@Model.ElectricityConsumption.ToString("N0") <span>kWh</span></h2>

            <div class="mini-trend">
                <span class="@(Model.ElectricityWeeklyGrowthPercent <= 0 ? "trend-positive" : "trend-negative")">
                    @(Model.ElectricityWeeklyGrowthPercent >= 0 ? "" : "")
                    @Math.Abs(Model.ElectricityWeeklyGrowthPercent).ToString("N1")%
                </span>
                <small>vs @Model.PreviousStart.ToString("dd MMM yyyy") - @Model.PreviousEnd.ToString("dd MMM yyyy")</small>
            </div>

            <canvas id="electricityMiniChart"></canvas>
            <div class="kpi-support">
                <span>Daily average</span>
                <strong>@Model.AverageDailyElectricity.ToString("N0") kWh</strong>
            </div>
        </div>

        <div class="figma-card kpi-card kpi-coverage">
            <p>Meter Data Coverage</p>
            <h2>@Model.DataCoveragePercent.ToString("N1")<span>%</span></h2>

            <div class="mini-trend">
                <span class="@(Model.DataCoveragePercent >= 90 ? "trend-positive" : "trend-negative")">
                    @(Model.DataCoveragePercent >= 90 ? " Healthy" : " Attention")
                </span>
                <small>days with both utilities recorded</small>
            </div>

            <div class="coverage-meter" aria-label="Meter data coverage @Model.DataCoveragePercent.ToString("N1") percent">
                <span style="width:@(Math.Min(100, Model.DataCoveragePercent).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span>
            </div>
            <div class="coverage-caption">
                <span>@Model.CompleteCoverageDays complete days</span>
                <strong>@Model.SelectedDayCount selected days</strong>
            </div>
        </div>

    </section>

    <section class="stats-grid stats-grid-3">

        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-droplet-fill"></i></div>
            <div class="stat-content">
                <p>Water Readings</p>
                <h2>@Model.WaterReadingCount.ToString("N0")</h2>
                <span>filtered date range</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon orange"><i class="bi bi-lightning-charge-fill"></i></div>
            <div class="stat-content">
                <p>Electricity Readings</p>
                <h2>@Model.ElectricityReadingCount.ToString("N0")</h2>
                <span>filtered date range</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon purple"><i class="bi bi-collection-fill"></i></div>
            <div class="stat-content">
                <p>Total Meter Readings</p>
                <h2>@Model.TotalMeterReadingCount.ToString("N0")</h2>
                <span>water + electricity only</span>
            </div>
        </div>

    </section>

    <div class="dashboard-section-heading">
        <div>
            <h2>Utility Trends</h2>
            <p>Separate scales prevent litres and kilowatt-hours from being compared as if they were the same unit.</p>
        </div>
        <span>@Model.DateRangeLabel</span>
    </div>

    <section class="utility-trend-grid">

        <div class="figma-card dashboard-analytic-card">
            <div class="card-header">
                <div>
                    <span class="dashboard-card-kicker">Water</span>
                    <h3 class="dashboard-card-title">Water Consumption Trend</h3>
                </div>
                <span>Litres (L)</span>
            </div>
            <div class="dashboard-chart-stage">
                <canvas id="waterTrendChart"></canvas>
            </div>
        </div>

        <div class="figma-card dashboard-analytic-card">
            <div class="card-header">
                <div>
                    <span class="dashboard-card-kicker electricity">Electricity</span>
                    <h3 class="dashboard-card-title">Electricity Consumption Trend</h3>
                </div>
                <span>Kilowatt-hours (kWh)</span>
            </div>
            <div class="dashboard-chart-stage">
                <canvas id="electricityTrendChart"></canvas>
            </div>
        </div>

    </section>

    <div class="dashboard-section-heading">
        <div>
            <h2>Area Performance</h2>
            <p>Every bar represents one area; the donut charts show each area's percentage of utility consumption.</p>
        </div>
        <span>Hover charts for consumption and share</span>
    </div>

    <section class="utility-area-grid">

        <div class="figma-card dashboard-analytic-card">
            <div class="card-header">
                <div>
                    <span class="dashboard-card-kicker">Water by Area</span>
                    <h3 class="dashboard-card-title">Area Consumption &amp; Share</h3>
                </div>
                @if (waterLeader != null)
                {
                    <span class="area-leader-badge">@waterLeader.AreaName  @waterLeaderShare.ToString("N1")% leader</span>
                }
            </div>

            <div class="area-visual-grid">
                <div class="area-bar-stage" style="height:@(Math.Max(290, Model.TopWaterAreas.Count * 46 + 80))px">
                    <canvas id="waterAreaBarChart"></canvas>
                </div>
                <div class="area-doughnut-stage">
                    <canvas id="waterAreaDonutChart"></canvas>
                </div>
            </div>
        </div>

        <div class="figma-card dashboard-analytic-card">
            <div class="card-header">
                <div>
                    <span class="dashboard-card-kicker electricity">Electricity by Area</span>
                    <h3 class="dashboard-card-title">Area Consumption &amp; Share</h3>
                </div>
                @if (electricityLeader != null)
                {
                    <span class="area-leader-badge electricity">@electricityLeader.AreaName · @electricityLeaderShare.ToString("N1")% leader</span>
                }
            </div>

            <div class="area-visual-grid">
                <div class="area-bar-stage" style="height:@(Math.Max(290, Model.TopElectricityAreas.Count * 46 + 80))px">
                    <canvas id="electricityAreaBarChart"></canvas>
                </div>
                <div class="area-doughnut-stage">
                    <canvas id="electricityAreaDonutChart"></canvas>
                </div>
            </div>
        </div>

    </section>

    <section class="executive-insights-grid">
        <div class="executive-insight">
            <p>Average Daily Water</p>
            <strong>@Model.AverageDailyWater.ToString("N0") L</strong>
            <span>Normalised over @Model.SelectedDayCount selected days</span>
        </div>
        <div class="executive-insight">
            <p>Average Daily Electricity</p>
            <strong>@Model.AverageDailyElectricity.ToString("N0") kWh</strong>
            <span>Normalised over @Model.SelectedDayCount selected days</span>
        </div>
        <div class="executive-insight">
            <p>Highest Water Area</p>
            <strong>@(waterLeader?.AreaName ?? "No data")</strong>
            <span>@(waterLeader == null ? "No area readings" : $"{waterLeader.TotalUsage:N0} L {waterLeaderShare:N1}% share")</span>
        </div>
        <div class="executive-insight">
            <p>Highest Electricity Area</p>
            <strong>@(electricityLeader?.AreaName ?? "No data")</strong>
            <span>@(electricityLeader == null ? "No area readings" : $"{electricityLeader.TotalUsage:N0} kWh {electricityLeaderShare:N1}% share")</span>
        </div>
    </section>

    <div class="dashboard-section-heading">
        <div>
            <h2>Management Pulse</h2>
            <p>Current calendar month compared with the previous calendar month.</p>
        </div>
        <span>@Model.PreviousMonthLabel vs @Model.CurrentMonthLabel</span>
    </div>

    <section class="comparison-management-grid">

        <div class="figma-card dashboard-analytic-card">
            <div class="card-header">
                <div>
                    <span class="dashboard-card-kicker">Water</span>
                    <h3 class="dashboard-card-title">Current vs Previous Month</h3>
                </div>
                <span class="@(Model.WaterMonthlyGrowthPercent <= 0 ? "trend-positive" : "trend-negative")">
                    @(Model.WaterMonthlyGrowthPercent >= 0 ? "+" : "")@Model.WaterMonthlyGrowthPercent.ToString("N1")%
                </span>
            </div>
            <div class="dashboard-chart-stage compact">
                <canvas id="waterComparisonChart"></canvas>
            </div>
        </div>

        <div class="figma-card dashboard-analytic-card">
            <div class="card-header">
                <div>
                    <span class="dashboard-card-kicker electricity">Electricity</span>
                    <h3 class="dashboard-card-title">Current vs Previous Month</h3>
                </div>
                <span class="@(Model.ElectricityMonthlyGrowthPercent <= 0 ? "trend-positive" : "trend-negative")">
                    @(Model.ElectricityMonthlyGrowthPercent >= 0 ? "+" : "")@Model.ElectricityMonthlyGrowthPercent.ToString("N1")%
                </span>
            </div>
            <div class="dashboard-chart-stage compact">
                <canvas id="electricityComparisonChart"></canvas>
            </div>
        </div>

        <div class="figma-card alerts-card">
            <div class="card-header">
                <h3>Management Alerts</h3>
                <span>15% increase / coverage below 90%</span>
            </div>

            @foreach (var alert in Model.Alerts)
            {
                <div class="alert-item alert-@alert.Type">
                    <div class="alert-dot"></div>
                    <div>
                        <strong>@alert.Title</strong>
                        <p>@alert.Message</p>
                    </div>
                </div>
            }
        </div>

    </section>

    <div class="dashboard-section-heading">
        <div>
            <h2>Leading Areas</h2>
            <p>Operational ranking for quick management follow-up.</p>
        </div>
        <span>Top five per utility</span>
    </div>

    <section class="grid-two">

        <div class="content-card">
            <div class="content-card-header">
                <div>
                    <h3>Top Water Areas</h3>
                    <p>Highest water consumption in the filtered date range.</p>
                </div>
            </div>

            <div class="progress-list">
                @if (Model.TopWaterAreas.Any())
                {
                    @foreach (var area in Model.TopWaterAreas.Take(5))
                    {
                        <div class="progress-row">
                            <div class="progress-row-header">
                                <strong>@area.AreaName</strong>
                                <span>@area.TotalUsage.ToString("N0") L</span>
                            </div>
                            <div class="utility-progress"><div style="width:@area.ProgressPercent%"></div></div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">No water area consumption found for this period.</div>
                }
            </div>
        </div>

        <div class="content-card">
            <div class="content-card-header">
                <div>
                    <h3>Top Electricity Areas</h3>
                    <p>Highest electricity consumption in the filtered date range.</p>
                </div>
            </div>

            <div class="progress-list">
                @if (Model.TopElectricityAreas.Any())
                {
                    @foreach (var area in Model.TopElectricityAreas.Take(5))
                    {
                        <div class="progress-row">
                            <div class="progress-row-header">
                                <strong>@area.AreaName</strong>
                                <span>@area.TotalUsage.ToString("N0") kWh</span>
                            </div>
                            <div class="utility-progress orange"><div style="width:@area.ProgressPercent%"></div></div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">No electricity area consumption found for this period.</div>
                }
            </div>
        </div>

    </section>

    <section class="bottom-grid">

        <div class="figma-card dashboard-monthly-summary-card">
            <div class="card-header">
                <h3>Calendar-Month Summary</h3>
                <span>@Model.PreviousMonthLabel vs @Model.CurrentMonthLabel</span>
            </div>

            <div class="summary-list compact-summary-list">
                <div class="summary-card-row">
                    <div>
                        <strong>Water</strong>
                        <span>@Model.PreviousMonthLabel: @Model.PreviousMonthWaterConsumption.ToString("N0") L</span>
                    </div>
                    <div>
                        <strong>@Model.CurrentMonthWaterConsumption.ToString("N0") L</strong>
                        <span class="@(Model.WaterMonthlyGrowthPercent <= 0 ? "trend-positive" : "trend-negative")">
                            @(Model.WaterMonthlyGrowthPercent >= 0 ? "" : "") @Math.Abs(Model.WaterMonthlyGrowthPercent).ToString("N1")%
                        </span>
                    </div>
                </div>

                <div class="summary-card-row">
                    <div>
                        <strong>Electricity</strong>
                        <span>@Model.PreviousMonthLabel: @Model.PreviousMonthElectricityConsumption.ToString("N0") kWh</span>
                    </div>
                    <div>
                        <strong>@Model.CurrentMonthElectricityConsumption.ToString("N0") kWh</strong>
                        <span class="@(Model.ElectricityMonthlyGrowthPercent <= 0 ? "trend-positive" : "trend-negative")">
                            @(Model.ElectricityMonthlyGrowthPercent >= 0 ? "" : "") @Math.Abs(Model.ElectricityMonthlyGrowthPercent).ToString("N1")%
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="figma-card">
            <div class="card-header">
                <h3>Recent Meter Readings</h3>
                <span>Latest entries in the filtered date range</span>
            </div>

            <table class="figma-table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Usage</th>
                        <th>Area</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentMeterReadings.Any())
                    {
                        @foreach (var reading in Model.RecentMeterReadings)
                        {
                            <tr>
                                <td>@reading.MeterType</td>
                                <td>@reading.Usage.ToString("N0") @reading.Unit</td>
                                <td>@(string.IsNullOrWhiteSpace(reading.AreaName) ? "Unknown Area" : reading.AreaName)</td>
                                <td>@reading.ReadingDate.ToString("dd MMM")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4">No meter readings found.</td></tr>
                    }
                </tbody>
            </table>
        </div>

    </section>

</div>

<div class="dashboard-export-status" id="dashboardExportStatus" role="status" aria-live="polite">
    <i class="bi bi-arrow-repeat"></i>
    <span>Preparing dashboard PDFâ€¦</span>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>

    <script>
        const dashboardDateFilter = document.getElementById('dashboardDateFilter');
        const dashboardCustomDateFilters = document.querySelectorAll('.dashboard-custom-date-filter');

        function toggleDashboardCustomDates() {
        const showCustom = dashboardDateFilter.value === 'Custom';
        dashboardCustomDateFilters.forEach(item => {
        item.style.display = showCustom ? 'flex' : 'none';
        });
        }

        dashboardDateFilter.addEventListener('change', toggleDashboardCustomDates);
        toggleDashboardCustomDates();

        const trendLabels = @Html.Raw(Model.TrendLabelsJson);
        const waterTrend = @Html.Raw(Model.WaterTrendJson);
        const electricityTrend = @Html.Raw(Model.ElectricityTrendJson);

        const waterAreaLabels = @Html.Raw(Model.WaterAreaLabelsJson);
        const waterAreaData = @Html.Raw(Model.WaterAreaDataJson);
        const electricityAreaLabels = @Html.Raw(Model.ElectricityAreaLabelsJson);
        const electricityAreaData = @Html.Raw(Model.ElectricityAreaDataJson);
        const monthComparisonLabels = @Html.Raw(Model.MonthComparisonLabelsJson);

        const chartPalette = [
        '#2aa8ff', '#43d890', '#ffad32', '#a78bfa', '#f472b6', '#22d3ee',
        '#fb7185', '#84cc16', '#facc15', '#818cf8', '#14b8a6', '#f97316'
        ];

        const numberFormatter = new Intl.NumberFormat(undefined, { maximumFractionDigits: 0 });

        Chart.defaults.color = '#7c8ca5';
        Chart.defaults.borderColor = 'rgba(148, 163, 184, 0.15)';
        Chart.defaults.font.family = "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif";

        const centerLabelPlugin = {
        id: 'centerLabel',
        afterDraw(chart, args, options) {
        if (chart.config.type !== 'doughnut' || !options || !options.value) return;

        const { ctx, chartArea } = chart;
        if (!chartArea) return;

        const x = (chartArea.left + chartArea.right) / 2;
        const y = (chartArea.top + chartArea.bottom) / 2;
        ctx.save();
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillStyle = '#18263a';
        ctx.font = '700 22px Inter, system-ui, sans-serif';
        ctx.fillText(options.value, x, y - 7);
        ctx.fillStyle = '#7c8ca5';
        ctx.font = '600 11px Inter, system-ui, sans-serif';
        ctx.fillText(options.label || 'top area', x, y + 15);
        ctx.restore();
        }
        };

        const noDataPlugin = {
        id: 'noData',
        afterDraw(chart, args, options) {
        const datasets = chart.data.datasets || [];
        const hasData = datasets.some(dataset => (dataset.data || []).some(value => Number(value) > 0));
        if (hasData) return;

        const { ctx, chartArea } = chart;
        if (!chartArea) return;
        ctx.save();
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillStyle = '#7c8ca5';
        ctx.font = '600 13px Inter, system-ui, sans-serif';
        ctx.fillText(options?.text || 'No data for this period', (chartArea.left + chartArea.right) / 2, (chartArea.top + chartArea.bottom) / 2);
        ctx.restore();
        }
        };

        Chart.register(centerLabelPlugin, noDataPlugin);

        function createMiniLineChart(canvasId, labels, data, color) {
        new Chart(document.getElementById(canvasId), {
        type: 'line',
        data: {
        labels,
        datasets: [{
        data,
        borderColor: color,
        backgroundColor: color,
        tension: 0.42,
        pointRadius: 0,
        borderWidth: 2
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 600 },
        plugins: { legend: { display: false }, tooltip: { enabled: false } },
        scales: { x: { display: false }, y: { display: false } }
        }
        });
        }

        function createTrendChart(canvasId, labels, data, label, unit, color, fillColor) {
        new Chart(document.getElementById(canvasId), {
        type: 'line',
        data: {
        labels,
        datasets: [{
        label,
        data,
        borderColor: color,
        backgroundColor: fillColor,
        fill: true,
        tension: 0.38,
        borderWidth: 3,
        pointRadius: data.length > 45 ? 0 : 2,
        pointHoverRadius: 5,
        pointBackgroundColor: color
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { intersect: false, mode: 'index' },
        plugins: {
        legend: { display: false },
        tooltip: {
        callbacks: {
        label: context => `${label}: ${numberFormatter.format(context.parsed.y)} ${unit}`
        }
        },
        noData: { text: `No ${label.toLowerCase()} readings for this period` }
        },
        scales: {
        x: { grid: { display: false }, ticks: { maxTicksLimit: 8 } },
        y: {
        beginAtZero: true,
        ticks: { callback: value => numberFormatter.format(value) },
        title: { display: true, text: unit }
        }
        }
        }
        });
        }

        function getAreaColors(length, startIndex = 0) {
        return Array.from({ length }, (_, index) => chartPalette[(index + startIndex) % chartPalette.length]);
        }

        function percentage(value, values) {
        const total = values.reduce((sum, item) => sum + Number(item || 0), 0);
        return total > 0 ? (Number(value || 0) * 100 / total) : 0;
        }

        function createAreaBarChart(canvasId, labels, data, utility, unit, startColorIndex) {
        new Chart(document.getElementById(canvasId), {
        type: 'bar',
        data: {
        labels,
        datasets: [{
        label: `${utility} consumption`,
        data,
        backgroundColor: getAreaColors(labels.length, startColorIndex),
        borderRadius: 7,
        borderSkipped: false,
        maxBarThickness: 28
        }]
        },
        options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        interaction: { intersect: false, mode: 'nearest', axis: 'y' },
        plugins: {
        legend: { display: false },
        tooltip: {
        callbacks: {
        title: items => items[0]?.label || '',
        label: context => `${utility}: ${numberFormatter.format(context.raw)} ${unit}`,
        afterLabel: context => `${percentage(context.raw, data).toFixed(1)}% of total ${utility.toLowerCase()} consumption`
        }
        },
        noData: { text: `No ${utility.toLowerCase()} area data` }
        },
        scales: {
        x: {
        beginAtZero: true,
        ticks: { callback: value => numberFormatter.format(value) },
        title: { display: true, text: unit }
        },
        y: { grid: { display: false }, ticks: { autoSkip: false } }
        }
        }
        });
        }

        function createAreaDonutChart(canvasId, labels, data, utility, unit, startColorIndex) {
        const topShare = data.length ? percentage(data[0], data) : 0;

        new Chart(document.getElementById(canvasId), {
        type: 'doughnut',
        data: {
        labels,
        datasets: [{
        data,
        backgroundColor: getAreaColors(labels.length, startColorIndex),
        borderColor: '#ffffff',
        borderWidth: 2,
        hoverOffset: 8
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '68%',
        plugins: {
        centerLabel: { value: `${topShare.toFixed(1)}%`, label: 'top area share' },
        legend: {
        position: 'bottom',
        labels: {
        usePointStyle: true,
        boxWidth: 8,
        padding: 13,
        generateLabels(chart) {
        return chart.data.labels.map((label, index) => ({
        text: `${label} (${percentage(chart.data.datasets[0].data[index], chart.data.datasets[0].data).toFixed(1)}%)`,
        fillStyle: chart.data.datasets[0].backgroundColor[index],
        strokeStyle: chart.data.datasets[0].backgroundColor[index],
        pointStyle: 'circle',
        hidden: false,
        index
        }));
        }
        },
        onClick(event, legendItem, legend) {
        legend.chart.toggleDataVisibility(legendItem.index);
        legend.chart.update();
        }
        },
        tooltip: {
        callbacks: {
        label: context => `${context.label}: ${numberFormatter.format(context.raw)} ${unit} (${percentage(context.raw, data).toFixed(1)}%)`
        }
        },
        noData: { text: `No ${utility.toLowerCase()} area data` }
        }
        }
        });
        }

        function createComparisonChart(canvasId, labels, previousValue, currentValue, utility, unit, color) {
        new Chart(document.getElementById(canvasId), {
        type: 'bar',
        data: {
        labels,
        datasets: [{
        label: utility,
        data: [previousValue, currentValue],
        backgroundColor: ['rgba(148, 163, 184, .55)', color],
        borderRadius: 8,
        borderSkipped: false,
        maxBarThickness: 64
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: context => `${numberFormatter.format(context.raw)} ${unit}` } },
        noData: { text: `No ${utility.toLowerCase()} readings for these months` }
        },
        scales: {
        x: { grid: { display: false } },
        y: { beginAtZero: true, ticks: { callback: value => numberFormatter.format(value) } }
        }
        }
        });
        }

        createMiniLineChart('waterMiniChart', trendLabels, waterTrend, '#2aa8ff');
        createMiniLineChart('electricityMiniChart', trendLabels, electricityTrend, '#f59e0b');

        createTrendChart('waterTrendChart', trendLabels, waterTrend, 'Water', 'L', '#2aa8ff', 'rgba(42, 168, 255, .12)');
        createTrendChart('electricityTrendChart', trendLabels, electricityTrend, 'Electricity', 'kWh', '#f59e0b', 'rgba(245, 158, 11, .12)');

        createAreaBarChart('waterAreaBarChart', waterAreaLabels, waterAreaData, 'Water', 'L', 0);
        createAreaDonutChart('waterAreaDonutChart', waterAreaLabels, waterAreaData, 'Water', 'L', 0);
        createAreaBarChart('electricityAreaBarChart', electricityAreaLabels, electricityAreaData, 'Electricity', 'kWh', 2);
        createAreaDonutChart('electricityAreaDonutChart', electricityAreaLabels, electricityAreaData, 'Electricity', 'kWh', 2);

        createComparisonChart(
        'waterComparisonChart',
        monthComparisonLabels,
        @Model.PreviousMonthWaterConsumption,
        @Model.CurrentMonthWaterConsumption,
        'Water',
        'L',
        '#2aa8ff');

        createComparisonChart(
        'electricityComparisonChart',
        monthComparisonLabels,
        @Model.PreviousMonthElectricityConsumption,
        @Model.CurrentMonthElectricityConsumption,
        'Electricity',
        'kWh',
        '#f59e0b');

        function printDashboard() {
        window.print();
        }

        async function downloadDashboardPdf() {
        const source = document.getElementById('dashboardExportSurface');
        const button = document.getElementById('downloadDashboardPdfButton');
        const printButton = document.getElementById('printDashboardButton');
        const status = document.getElementById('dashboardExportStatus');
        const statusText = status.querySelector('span');
        const originalWidth = source.style.width;

        if (!window.html2canvas || !window.jspdf) {
        statusText.textContent = 'PDF tools could not be loaded. Please check your connection and try again.';
        status.classList.add('visible', 'error');
        window.setTimeout(() => status.classList.remove('visible', 'error'), 4500);
        return;
        }

        button.disabled = true;
        printButton.disabled = true;
        statusText.textContent = 'Preparing dashboard PDFâ€¦';
        status.classList.remove('error');
        status.classList.add('visible');
        source.classList.add('pdf-export-mode');
        source.style.width = '1180px';

        try {
        await new Promise(resolve => window.setTimeout(resolve, 500));

        const canvas = await window.html2canvas(source, {
        scale: 2,
        useCORS: true,
        allowTaint: false,
        backgroundColor: '#f4f7fb',
        logging: false,
        windowWidth: 1220,
        scrollX: 0,
        scrollY: -window.scrollY
        });

        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4', compress: true });
        const pageWidth = pdf.internal.pageSize.getWidth();
        const pageHeight = pdf.internal.pageSize.getHeight();
        const margin = 8;
        const footerSpace = 8;
        const contentWidth = pageWidth - (margin * 2);
        const contentHeight = pageHeight - (margin * 2) - footerSpace;
        const imageHeight = canvas.height * contentWidth / canvas.width;
        const imageData = canvas.toDataURL('image/jpeg', 0.92);
        const pageCount = Math.max(1, Math.ceil(imageHeight / contentHeight));

        for (let pageIndex = 0; pageIndex < pageCount; pageIndex++) {
        if (pageIndex > 0) pdf.addPage();
        const yPosition = margin - (pageIndex * contentHeight);
        pdf.addImage(imageData, 'JPEG', margin, yPosition, contentWidth, imageHeight, 'dashboardImage', 'FAST');
        pdf.setFillColor(255, 255, 255);
        pdf.rect(0, pageHeight - footerSpace - 1, pageWidth, footerSpace + 1, 'F');
        pdf.setTextColor(100, 116, 139);
        pdf.setFontSize(8);
        pdf.text(`Utilities Management Dashboard Â· @Model.DateRangeLabel`, margin, pageHeight - 3.5);
        pdf.text(`Page ${pageIndex + 1} of ${pageCount}`, pageWidth - margin, pageHeight - 3.5, { align: 'right' });
        }

        pdf.save('utilities-dashboard-@(Model.CurrentStart.ToString("yyyyMMdd"))-@(Model.CurrentEnd.ToString("yyyyMMdd")).pdf');
        statusText.textContent = 'Dashboard PDF downloaded.';
        window.setTimeout(() => status.classList.remove('visible'), 2500);
        } catch (error) {
        console.error('Dashboard PDF export failed:', error);
        statusText.textContent = 'The PDF could not be created. Please try again.';
        status.classList.add('error');
        window.setTimeout(() => status.classList.remove('visible', 'error'), 4500);
        } finally {
        source.classList.remove('pdf-export-mode');
        source.style.width = originalWidth;
        button.disabled = false;
        printButton.disabled = false;
        }
        }
    </script>
}