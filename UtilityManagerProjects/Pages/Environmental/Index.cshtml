@page
@model UtilityManagerProjects.Pages.Environmental.IndexModel

@{
    ViewData["Title"] = "Environmental Dashboard";
}

<style>
    .management-chart-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 1.25rem;
        margin-top: 1.25rem;
    }

    .management-chart-grid > .figma-card {
        min-width: 0;
    }

    .meter-trend-card { grid-column: span 8; }
    .waste-trend-card { grid-column: span 4; }
    .alerts-card { grid-column: span 7; }
    .distribution-card { grid-column: span 5; }

    .meter-chart-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .chart-panel {
        min-width: 0;
        padding: .9rem;
        border: 1px solid rgba(148, 163, 184, .14);
        border-radius: .85rem;
        background: rgba(15, 23, 42, .22);
    }

    .chart-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: .5rem;
    }

    .chart-panel-header strong { font-size: .9rem; }
    .chart-panel-header span { color: #8ea2bd; font-size: .75rem; }

    .trend-chart-shell { height: 270px; }
    .mini-trend-chart-shell { height: 230px; }

    .dashboard-data-section {
        display: grid;
        gap: 1.25rem;
        margin-top: 1.25rem;
    }

    .table-card { overflow: hidden; }

    .dashboard-table-wrap {
        overflow-x: auto;
        max-height: 430px;
    }

    .management-table {
        width: 100%;
        border-collapse: collapse;
        white-space: nowrap;
    }

    .management-table th,
    .management-table td {
        padding: .85rem 1rem;
        border-bottom: 1px solid rgba(148, 163, 184, .12);
        text-align: left;
        vertical-align: middle;
    }

    .management-table th {
        position: sticky;
        top: 0;
        z-index: 1;
        color: #8ea2bd;
        background: #111c2f;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .management-table td { font-size: .87rem; }
    .management-table .numeric { text-align: right; }
    .management-table tbody tr:hover { background: rgba(148, 163, 184, .05); }

    .metric-badge {
        display: inline-flex;
        align-items: center;
        padding: .25rem .55rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 700;
    }

    .metric-badge-water { color: #38bdf8; background: rgba(56, 189, 248, .12); }
    .metric-badge-electricity { color: #fbbf24; background: rgba(251, 191, 36, .12); }
    .metric-badge-recycling { color: #4ade80; background: rgba(74, 222, 128, .12); }
    .metric-badge-landfill { color: #fb7185; background: rgba(251, 113, 133, .12); }
    .metric-badge-other { color: #cbd5e1; background: rgba(203, 213, 225, .12); }

    .table-empty-state {
        padding: 2rem;
        color: #8ea2bd;
        text-align: center;
    }

    @@media (max-width: 1100px) {
        .meter-trend-card,
        .waste-trend-card,
        .alerts-card,
        .distribution-card { grid-column: span 12; }
    }

    @@media (max-width: 720px) {
        .meter-chart-grid { grid-template-columns: 1fr; }
        .trend-chart-shell,
        .mini-trend-chart-shell { height: 235px; }
    }
</style>

<div class="page-shell environmental-page">

    <div class="page-header-row">
        <div class="page-title">
            <h1>Environmental Dashboard</h1>
            <p>Management view of resource consumption, waste diversion, carbon estimate, and per-person performance. Showing @Model.DateRangeLabel.</p>
        </div>
    </div>

    <form method="get" class="dashboard-filter-card">

        <div class="filter-group">
            <label>Date Range</label>
            <select name="DateFilter" class="utility-input" id="environmentDateFilter">
                <option value="Last7" selected="@(Model.DateFilter == "Last7" ? "selected" : null)">Latest 7 Days</option>
                <option value="Last30" selected="@(Model.DateFilter == "Last30" ? "selected" : null)">Latest 30 Days</option>
                <option value="Custom" selected="@(Model.DateFilter == "Custom" ? "selected" : null)">Custom</option>
            </select>
        </div>

        <div class="filter-group environment-custom-date-filter">
            <label>Start Date</label>
            <input type="date"
                   name="StartDate"
                   value="@(Model.StartDate?.ToString("yyyy-MM-dd") ?? Model.CurrentStart.ToString("yyyy-MM-dd"))"
                   class="utility-input" />
        </div>

        <div class="filter-group environment-custom-date-filter">
            <label>End Date</label>
            <input type="date"
                   name="EndDate"
                   value="@(Model.EndDate?.ToString("yyyy-MM-dd") ?? Model.CurrentEnd.ToString("yyyy-MM-dd"))"
                   class="utility-input" />
        </div>

        <div class="filter-actions">
            <button type="submit" class="utility-btn-primary">
                <i class="bi bi-funnel"></i>
                Apply Filter
            </button>

            <a asp-page="./Index" class="utility-btn-secondary">
                Clear
            </a>
        </div>

    </form>

    <section class="stats-grid stats-grid-4">

        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-droplet-fill"></i>
            </div>
            <div class="stat-content">
                <p>Water Use</p>
                <h2>@Model.WaterUsage.ToString("N0") <span>L</span></h2>
                <span class="@(Model.WaterPerPerson <= Model.WaterTarget ? "trend-positive" : "trend-negative")">
                    @Model.WaterPerPerson.ToString("N2") L/person · Target @Model.WaterTarget.ToString("N2")
                </span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div class="stat-content">
                <p>Electricity Use</p>
                <h2>@Model.ElectricityUsage.ToString("N0") <span>kWh</span></h2>
                <span class="@(Model.ElectricityPerPerson <= Model.ElectricityTarget ? "trend-positive" : "trend-negative")">
                    @Model.ElectricityPerPerson.ToString("N2") kWh/person · Target @Model.ElectricityTarget.ToString("N2")
                </span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon green">
                <i class="bi bi-recycle"></i>
            </div>
            <div class="stat-content">
                <p>Recycling</p>
                <h2>@Model.RecyclingPercent.ToString("N1") <span>%</span></h2>
                <span class="@(Model.RecyclingPercent >= Model.RecyclingTarget ? "trend-positive" : "trend-negative")">
                    Target @Model.RecyclingTarget.ToString("N0")%
                </span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon purple">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-content">
                <p>Total People</p>
                <h2>@Model.TotalPeople.ToString("N0")</h2>
                <span>@Model.TotalVisitors.ToString("N0") visitors · @Model.TotalEmployees.ToString("N0") employees</span>
            </div>
        </div>

    </section>

    <section class="stats-grid stats-grid-4">

        <div class="stat-card">
            <div class="stat-icon green">
                <i class="bi bi-trash3-fill"></i>
            </div>
            <div class="stat-content">
                <p>Total Waste</p>
                <h2>@Model.WasteTotal.ToString("N0") <span>kg</span></h2>
                <span>selected period</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon green">
                <i class="bi bi-arrow-repeat"></i>
            </div>
            <div class="stat-content">
                <p>Recycling Waste</p>
                <h2>@Model.RecyclingWaste.ToString("N0") <span>kg</span></h2>
                <span>classified from waste category/type/material</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon red">
                <i class="bi bi-trash-fill"></i>
            </div>
            <div class="stat-content">
                <p>Landfill Waste</p>
                <h2>@Model.LandfillWaste.ToString("N0") <span>kg</span></h2>
                <span>classified from waste category/type/material</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="bi bi-cloud-haze2-fill"></i>
            </div>
            <div class="stat-content">
                <p>Carbon Estimate</p>
                <h2>@Model.EstimatedCarbonKg.ToString("N0") <span>kg</span></h2>
                <span class="@(Model.EstimatedCarbonPerPerson <= Model.CarbonTarget ? "trend-positive" : "trend-negative")">
                    @Model.EstimatedCarbonPerPerson.ToString("N2") kg/person · Target @Model.CarbonTarget.ToString("N2")
                </span>
            </div>
        </div>

    </section>

    <section class="management-chart-grid">

        <div class="figma-card meter-trend-card">
            <div class="card-header">
                <h3>Meter Reading Trends</h3>
                <span>@Model.DateRangeLabel</span>
            </div>

            <div class="meter-chart-grid">
                <div class="chart-panel">
                    <div class="chart-panel-header">
                        <strong>Water consumption</strong>
                        <span>Litres (L)</span>
                    </div>
                    <div class="mini-trend-chart-shell">
                        <canvas id="waterTrendChart" aria-label="Water consumption trend" role="img"></canvas>
                    </div>
                </div>

                <div class="chart-panel">
                    <div class="chart-panel-header">
                        <strong>Electricity consumption</strong>
                        <span>Kilowatt-hours (kWh)</span>
                    </div>
                    <div class="mini-trend-chart-shell">
                        <canvas id="electricityTrendChart" aria-label="Electricity consumption trend" role="img"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="figma-card waste-trend-card">
            <div class="card-header">
                <h3>Waste Trend</h3>
                <span>Stacked by destination · kg</span>
            </div>

            <div class="trend-chart-shell">
                <canvas id="wasteTrendChart" aria-label="Waste trend by destination" role="img"></canvas>
            </div>
        </div>

        <div class="figma-card alerts-card">
            <div class="card-header">
                <h3>Management Attention</h3>
                <span>Performance against current targets</span>
            </div>

            @foreach (var alert in Model.Alerts)
            {
                <div class="alert-item alert-@alert.Type">
                    <div class="alert-dot"></div>
                    <div>
                        <strong>@alert.Title</strong>
                        <p>@alert.Message</p>
                    </div>
                </div>
            }
        </div>

        <div class="figma-card distribution-card">
            <div class="card-header">
                <h3>Waste Destination Mix</h3>
                <span>Selected period</span>
            </div>

            <div class="trend-chart-shell">
                <canvas id="wasteSplitChart" aria-label="Waste destination mix" role="img"></canvas>
            </div>
        </div>

    </section>

    <section class="dashboard-data-section">
        <div class="figma-card table-card">
            <div class="card-header">
                <h3>Meter Readings</h3>
                <span>@Model.MeterReadingRows.Count records · Water and electricity</span>
            </div>

            @if (Model.MeterReadingRows.Any())
            {
                <div class="dashboard-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Meter</th>
                                <th class="numeric">Consumption</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reading in Model.MeterReadingRows)
                            {
                                <tr>
                                    <td>@reading.ReadingDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="metric-badge metric-badge-@reading.MeterType.ToLowerInvariant()">
                                            @reading.MeterType
                                        </span>
                                    </td>
                                    <td class="numeric"><strong>@reading.Usage.ToString("N2")</strong> @reading.Unit</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="table-empty-state">No water or electricity meter readings were recorded in this period.</div>
            }
        </div>

        <div class="figma-card table-card">
            <div class="card-header">
                <h3>Waste Readings</h3>
                <span>@Model.WasteReadingRows.Count records · @Model.WasteTotal.ToString("N0") kg total</span>
            </div>

            @if (Model.WasteReadingRows.Any())
            {
                <div class="dashboard-table-wrap">
                    <table class="management-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th>Material</th>
                                <th>Destination</th>
                                <th class="numeric">Weight</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reading in Model.WasteReadingRows)
                            {
                                <tr>
                                    <td>@reading.ReadingDate.ToString("dd MMM yyyy")</td>
                                    <td>@reading.Category</td>
                                    <td>@reading.WasteType</td>
                                    <td>@reading.Material</td>
                                    <td>
                                        <span class="metric-badge metric-badge-@reading.Classification.ToLowerInvariant()">
                                            @reading.Classification
                                        </span>
                                    </td>
                                    <td class="numeric"><strong>@reading.WeightKg.ToString("N2")</strong> kg</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="table-empty-state">No waste readings were recorded in this period.</div>
            }
        </div>
    </section>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const environmentDateFilter = document.getElementById('environmentDateFilter');
        const environmentCustomDateFilters = document.querySelectorAll('.environment-custom-date-filter');

        function toggleEnvironmentCustomDates() {
        const showCustom = environmentDateFilter.value === 'Custom';

        environmentCustomDateFilters.forEach(item => {
        item.style.display = showCustom ? 'flex' : 'none';
        });
        }

        environmentDateFilter.addEventListener('change', toggleEnvironmentCustomDates);
        toggleEnvironmentCustomDates();

        const trendLabels = @Html.Raw(Model.TrendLabelsJson);
        const waterTrend = @Html.Raw(Model.WaterTrendJson);
        const electricityTrend = @Html.Raw(Model.ElectricityTrendJson);
        const recyclingWasteTrend = @Html.Raw(Model.RecyclingWasteTrendJson);
        const landfillWasteTrend = @Html.Raw(Model.LandfillWasteTrendJson);
        const otherWasteTrend = @Html.Raw(Model.OtherWasteTrendJson);

        const wasteSplitLabels = @Html.Raw(Model.WasteSplitLabelsJson);
        const wasteSplitData = @Html.Raw(Model.WasteSplitDataJson);

        Chart.defaults.color = '#8ea2bd';
        Chart.defaults.borderColor = 'rgba(148, 163, 184, 0.15)';

        function createConsumptionTrend(canvasId, label, data, color, unit) {
        return new Chart(document.getElementById(canvasId), {
        type: 'line',
        data: {
        labels: trendLabels,
        datasets: [{
        label,
        data,
        borderColor: color,
        backgroundColor: `${color}1f`,
        fill: true,
        tension: 0.35,
        borderWidth: 2.5,
        pointRadius: trendLabels.length > 31 ? 0 : 2,
        pointHoverRadius: 5
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
        mode: 'index',
        intersect: false
        },
        plugins: {
        legend: { display: false },
        tooltip: {
        callbacks: {
        label: context => `${label}: ${context.parsed.y.toLocaleString()} ${unit}`
        }
        }
        },
        scales: {
        x: {
        grid: { display: false },
        ticks: { maxTicksLimit: 7, maxRotation: 0 }
        },
        y: {
        beginAtZero: true,
        ticks: {
        callback: value => `${Number(value).toLocaleString()} ${unit}`
        }
        }
        }
        }
        });
        }

        createConsumptionTrend('waterTrendChart', 'Water', waterTrend, '#28a8ff', 'L');
        createConsumptionTrend('electricityTrendChart', 'Electricity', electricityTrend, '#ff9f2a', 'kWh');

        new Chart(document.getElementById('wasteTrendChart'), {
        type: 'bar',
        data: {
        labels: trendLabels,
        datasets: [
        {
        label: 'Recycling',
        data: recyclingWasteTrend,
        backgroundColor: '#4ade80',
        borderRadius: 4
        },
        {
        label: 'Landfill',
        data: landfillWasteTrend,
        backgroundColor: '#ef4444',
        borderRadius: 4
        },
        {
        label: 'Other',
        data: otherWasteTrend,
        backgroundColor: '#94a3b8',
        borderRadius: 4
        }
        ]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
        mode: 'index',
        intersect: false
        },
        plugins: {
        legend: {
        position: 'bottom',
        labels: { usePointStyle: true, boxWidth: 8 }
        },
        tooltip: {
        callbacks: {
        label: context => `${context.dataset.label}: ${context.parsed.y.toLocaleString()} kg`
        }
        }
        },
        scales: {
        x: {
        stacked: true,
        grid: { display: false },
        ticks: { maxTicksLimit: 7, maxRotation: 0 }
        },
        y: {
        stacked: true,
        beginAtZero: true,
        ticks: {
        callback: value => `${Number(value).toLocaleString()} kg`
        }
        }
        }
        }
        });

        new Chart(document.getElementById('wasteSplitChart'), {
        type: 'doughnut',
        data: {
        labels: wasteSplitLabels,
        datasets: [{
        data: wasteSplitData,
        backgroundColor: ['#4ade80', '#ef4444', '#94a3b8'],
        borderWidth: 0,
        hoverOffset: 6
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '65%',
        plugins: {
        legend: {
        position: 'right',
        labels: { usePointStyle: true, boxWidth: 8 }
        },
        tooltip: {
        callbacks: {
        label: context => `${context.label}: ${context.parsed.toLocaleString()} kg`
        }
        }
        }
        }
        });
    </script>
}
