@page
@model UtilityManagerProjects.Pages.Area.CreateModel
@{ ViewData["Title"] = Model.Id.HasValue ? "Edit area" : "Add area"; }
<div class="page-shell admin-form-shell">
 <div class="page-header-row"><div class="page-title"><h1>@ViewData["Title"]</h1><p>Areas belong to a location.</p></div></div>
 <form method="post" class="content-card utility-form">
  <input type="hidden" asp-for="Id" />
  <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
  <div class="form-group"><label asp-for="Input.Name">Area name</label><input asp-for="Input.Name" class="utility-input" maxlength="100" /><span asp-validation-for="Input.Name" class="text-danger"></span></div>
  <div class="form-group"><label asp-for="Input.StationId">Location</label><select asp-for="Input.StationId" class="utility-input"><option value="0">Select a location</option>@foreach(var location in Model.Locations.Where(l=>l.IsActive)) { <option value="@location.Id">@location.Name</option> }</select><span asp-validation-for="Input.StationId" class="text-danger"></span></div>
  <label class="check-row"><input asp-for="Input.IsActive" /> Active</label>
  <p class="form-hint">Referenced records are kept for history. Move or deactivate active dependants before deactivating this record.</p>
  <div class="form-actions"><button class="utility-btn-primary" type="submit">Save area</button><a asp-page="/Area/AreaIndex" class="utility-btn-secondary">Cancel</a></div>
 </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
