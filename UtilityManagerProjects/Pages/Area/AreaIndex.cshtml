@page
@model UtilityManagerProjects.Pages.Areas.IndexModel
@{ ViewData["Title"]="Areas"; }
<div class="page-shell">
 <div class="page-header-row"><div class="page-title"><h1>Areas</h1><p>Manage areas and their locations.</p></div><a asp-page="./Create" class="utility-btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>Add area</a></div>
 @if(TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
 @if(TempData["ErrorMessage"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
 <section class="content-card"><div class="table-wrap"><table class="utility-table"><thead><tr><th>Name</th><th>Location</th><th>Status</th><th>Actions</th></tr></thead><tbody>
 @foreach(var row in Model.Rows) { <tr><td>@row.Name</td><td>@row.StationName</td><td>@(row.IsActive?"Active":"Inactive")</td><td><div class="row-actions"><a asp-page="./Create" asp-route-id="@row.Id" class="utility-btn-secondary">Edit</a><form method="post" asp-page-handler="Delete"><input type="hidden" name="id" value="@row.Id"/><button type="submit" class="utility-btn-danger" onclick="return confirm('Delete this record? Records used by meters or areas cannot be deleted.');">Delete</button></form></div></td></tr> }
 @if(!Model.Rows.Any()) { <tr><td colspan="4" class="empty-state">No areas yet.</td></tr> }
 </tbody></table></div></section>
</div>
