@page
@model UtilityManagerProjects.Pages.WasteReadings.CreateModel
@{
    ViewData["Title"] = "Create Waste Reading";
}
<div class="page-shell form-page-shell">
    <div class="page-header-row">
        <div class="page-title">
            <h1>Create Waste Reading</h1>
            <p>Capture a new waste amount, type, date, and notes.</p>
        </div>
        <div class="page-actions">
            <a class="utility-btn-secondary" asp-page="./List">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>
    <section class="content-card form-card">
        <div class="content-card-header">
            <div><h3>Waste Reading Information</h3><p>Complete the required fields.</p></div>
            <div class="form-card-icon green"><i class="bi bi-recycle"></i></div>
        </div>
        <form method="post" class="utility-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="form-grid">
                <div class="form-group form-group-full">
                    <label asp-for="WasteRecord.WasteTypeId">Waste Type</label>
                    <select asp-for="WasteRecord.WasteTypeId" asp-items="Model.WasteTypeList" class="utility-input">
                        <option value="">Select Waste Type</option>
                    </select>
                    <span asp-validation-for="WasteRecord.WasteTypeId" class="field-validation"></span>
                </div>
                <div class="form-group">
                    <label asp-for="WasteRecord.WasteAmount">Waste Amount</label>
                    <div class="input-with-unit">
                        <input asp-for="WasteRecord.WasteAmount" class="utility-input" type="number" min="0" step="0.01" />
                        <span>kg</span>
                    </div>
                    <span asp-validation-for="WasteRecord.WasteAmount" class="field-validation"></span>
                </div>
                <div class="form-group">
                    <label asp-for="WasteRecord.ReadingDate">Reading Date</label>
                    <input asp-for="WasteRecord.ReadingDate" class="utility-input" type="datetime-local" />
                    <span asp-validation-for="WasteRecord.ReadingDate" class="field-validation"></span>
                </div>
                <div class="form-group form-group-full">
                    <label asp-for="WasteRecord.Notes">Notes</label>
                    <textarea asp-for="WasteRecord.Notes" class="utility-input utility-textarea" rows="5"></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="utility-btn-primary">
                    <i class="bi bi-check-lg"></i> Save Waste Reading
                </button>
                <a asp-page="./List" class="utility-btn-secondary">Cancel</a>
            </div>
        </form>
    </section>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
