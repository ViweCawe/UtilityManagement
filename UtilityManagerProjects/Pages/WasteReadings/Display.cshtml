@page
@model UtilityManagerProjects.Pages.WasteReadings.DisplayModel
@{
    ViewData["Title"] = "Waste Reading Details";
}
<div class="page-shell">
    <div class="page-header-row">
        <div class="page-title">
            <h1>Waste Reading Details</h1>
            <p>View the selected waste reading and update its notes.</p>
        </div>
        <div class="page-actions">
            <a class="utility-btn-secondary" asp-page="./List">
                <i class="bi bi-arrow-left"></i> Back to Waste Readings
            </a>
        </div>
    </div>

    @if (Model.WasteRecord != null)
    {
        <section class="grid-two detail-page-grid">
            <div class="content-card">
                <div class="content-card-header">
                    <div>
                        <h3>Reading Information</h3>
                        <p>Waste reading WR-@Model.WasteRecord.Id.ToString("0000").</p>
                    </div>
                    <span class="reading-pill reading-waste">@Model.WasteRecord.WasteTypeName</span>
                </div>
                <div class="detail-list">
                    <div class="detail-row"><span>Waste Type</span><strong>@Model.WasteRecord.WasteTypeName</strong></div>
                    <div class="detail-row"><span>Material</span><strong>@Model.WasteRecord.MaterialName</strong></div>
                    <div class="detail-row"><span>Category</span><strong>@Model.WasteRecord.CategoryName</strong></div>
                    <div class="detail-row"><span>Waste Amount</span><strong class="detail-amount">@Model.WasteRecord.WasteAmount.ToString("N2") @Model.WasteRecord.Unit</strong></div>
                    <div class="detail-row"><span>Reading Date</span><strong>@Model.WasteRecord.ReadingDate.ToString("dd MMM yyyy HH:mm")</strong></div>
                    <div class="detail-row"><span>Notes</span><strong>@(string.IsNullOrWhiteSpace(Model.WasteRecord.Notes) ? "No notes captured" : Model.WasteRecord.Notes)</strong></div>
                </div>
                <div class="form-actions detail-actions">
                    <a class="utility-btn-secondary" asp-page="./History" asp-route-wasteTypeId="@Model.WasteRecord.WasteTypeId">
                        <i class="bi bi-clock-history"></i> View History
                    </a>
                    <a class="utility-btn-danger" asp-page="./Delete" asp-route-id="@Model.WasteRecord.Id">
                        <i class="bi bi-trash"></i> Delete Reading
                    </a>
                </div>
            </div>

            <div class="content-card">
                <div class="content-card-header">
                    <div><h3>Update Reading</h3><p>Change the editable information.</p></div>
                </div>
                <form method="post" class="utility-form">
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                    <input type="hidden" asp-for="WasteRecordUpdate.Id" />
                    <div class="form-group">
                        <label asp-for="WasteRecordUpdate.wasteReadingUpdate">Waste Amount</label>
                        <input asp-for="WasteRecordUpdate.wasteReadingUpdate" class="utility-input" type="number" step="0.01" min="0" />
                        <span asp-validation-for="WasteRecordUpdate.wasteReadingUpdate" class="field-validation"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="WasteRecordUpdate.Notes">Notes</label>
                        <textarea asp-for="WasteRecordUpdate.Notes" class="utility-input utility-textarea" rows="5"></textarea>
                        <span asp-validation-for="WasteRecordUpdate.Notes" class="field-validation"></span>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="utility-btn-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
                        <a class="utility-btn-secondary" asp-page="./List">Cancel</a>
                    </div>
                </form>
            </div>
        </section>
    }
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
