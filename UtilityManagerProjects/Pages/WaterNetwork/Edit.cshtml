@page "/WaterNetwork/Edit"
@model UtilityManagerProjects.Pages.WaterNetwork.EditModel
@using System.Text.Json
@{ ViewData["Title"]="Edit Water Network"; }
@section Styles { <link rel="stylesheet" href="~/css/network-editor.css" asp-append-version="true" /> }
<div class="page-shell network-editor">
 <header class="ne-header"><div><h1>Edit water network</h1><p>Start at a supply, then follow its meters and branches downstream.</p></div><a asp-page="./Index">Back to network</a></header>
 <form method="post" id="network-edit-form" data-create-meter-url="@Url.Page("/Meters/Create")">
  <div asp-validation-summary="All" class="ne-errors" role="alert"></div><input asp-for="NetworkJson" type="hidden"/><input asp-for="Revision" type="hidden"/>
  <div id="network-editor-error" class="ne-errors" role="alert" hidden></div>
  <noscript><p>Enable JavaScript to edit the map. The network viewing page remains available.</p></noscript>
  <div id="network-editor-controls" hidden>
   <section class="ne-section"><h2>1. Choose what you want to do</h2>
    <label>Task<select id="network-editor-task"><option value="add">Connect a new meter or outlet</option><option value="move">Change suppliers for an existing point</option><option value="review">Review names, meter links and reporting roles</option></select></label>
    <p class="form-hint">Creating a meter and connecting it are separate steps. Moving a point changes its supply routes, not its meter identity or saved readings.</p>
    <div id="network-editor-workspace"></div>
   </section>
   <section class="ne-section"><h2>2. Review the flow, from source to use</h2><p>Points are grouped by supply and ordered with their suppliers first. Shared areas show both sources. Open a point to edit its details.</p><div id="network-editor-points"></div></section>
   <section class="ne-section"><h2>3. Check before saving</h2><div id="network-editor-review"></div><p>Changing suppliers or reporting boundaries also changes how existing readings are grouped. The meter records and reading history are kept.</p><p>A combined meter cannot split municipal basin water from borehole flushing water. Separate inlet counters are needed for exact source volumes at an area.</p></section>
   <footer class="ne-actions"><a asp-page="./Edit">Reload saved map</a><a asp-page="./Index">Cancel</a><button type="submit">Save reviewed network</button></footer>
  </div>
 </form>
</div>
<script id="network-editor-meters" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.AvailableMeters.Select(m=>new{id=m.Id,name=m.MeterName,role=(int)m.NetworkRole})))</script>
@section Scripts { <script type="module" src="~/js/network-editor.js" asp-append-version="true"></script> }
