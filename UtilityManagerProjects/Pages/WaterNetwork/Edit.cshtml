@page "/WaterNetwork/Edit"
@model UtilityManagerProjects.Pages.WaterNetwork.EditModel
@using System.Text.Json
@{
    ViewData["Title"] = "Edit Water Network";
}
@section Styles { <link rel="stylesheet" href="~/css/network-editor.css" asp-append-version="true" /> }
<div class="page-shell network-editor">
    <header class="ne-header"><div><h1>Edit Water Network</h1><p>Add meters, tanks and outlets, then choose what supplies each point.</p></div><a asp-page="./Index">Back to network</a></header>
    <div class="ne-help">Create a new meter in <a asp-page="/Meters/Create">Add Meter or Tank</a> first, then select it here. An unmetered outlet can be added without a meter. Removing a point preserves its meter and reading history.</div>
    <form method="post" id="network-edit-form">
        <div asp-validation-summary="All" class="ne-errors" role="alert"></div>
        <input asp-for="NetworkJson" type="hidden" />
        <input asp-for="Revision" type="hidden" />
        <div id="network-editor-error" class="ne-errors" role="alert" hidden></div>
        <noscript><p>Enable JavaScript to edit the network. The viewing page remains available.</p></noscript>
        <div id="network-editor-controls" hidden>
            <section class="ne-section"><div class="ne-title"><h2>1. Network points</h2><button type="button" id="add-network-point">Add point</button></div><p>Name each point, choose its role, and link its actual meter when available.</p><div id="network-editor-points"></div></section>
            <section class="ne-section"><div class="ne-title"><h2>2. Supply connections</h2><button type="button" id="add-network-route">Add connection</button></div><p>“From” supplies “To”. Conditional routes need a description of when they are used.</p><div id="network-editor-routes"></div></section>
            <footer class="ne-actions"><a asp-page="./Edit">Reload saved map</a><span>The diagram is arranged automatically when saved.</span><a asp-page="./Index">Cancel</a><button type="submit">Save network</button></footer>
        </div>
    </form>
</div>
<script id="network-editor-meters" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.AvailableMeters.Select(m => new { id = m.Id, name = m.MeterName, role = (int)m.NetworkRole })))</script>
@section Scripts { <script type="module" src="~/js/network-editor.js" asp-append-version="true"></script> }
