@page "/WaterNetwork"
@model UtilityManagerProjects.Pages.WaterNetwork.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Water Network";
    var names = Model.Network.Nodes.ToDictionary(n => n.Id, n => n.Label);
}
@section Styles {
    <link rel="stylesheet" href="~/css/water-network.css" asp-append-version="true" />
}
<div class="page-shell water-network">
    <header class="page-header-row">
        <div class="page-title"><h1>Water Network</h1><p>Follow water from supply, through storage, to use.</p></div>
    </header>

    @if(ViewData["DateNotice"] is string notice){<p class="alert alert-info">@notice</p>}
    <form method="get" class="wn-controls content-card">
        <label asp-for="StartDate">Flow from<input asp-for="StartDate" type="date" class="utility-input"/></label>
        <label asp-for="EndDate">Through<input asp-for="EndDate" type="date" class="utility-input"/></label>
        <button type="submit" class="utility-btn-primary">Show flow</button>
        <a class="utility-btn-secondary" asp-page="/WaterBalance/Index" asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")">Compare station flows and borehole</a>
    </form>
    @if (TempData["LinkError"] is string linkError) { <p class="alert alert-warning" role="alert">@linkError</p> }
    @if (User.IsInRole("Admin"))
    {
        <section class="content-card wn-assignment">
            <h2>Link a point to its actual meter</h2>
            <p>Choose the point on the diagram and the meter you created. Each meter can be assigned to one point.</p>
            <form method="post" asp-page-handler="Link" class="wn-controls">
                <label>Diagram point<select name="nodeId" required>@foreach (var point in Model.Network.Nodes.Where(n => n.CanLinkMeter)) { <option value="@point.Id">@point.Label (@point.Station)</option> }</select></label>
                <label>Actual water meter<select name="meterId"><option value="">Remove assignment</option>@foreach (var meter in Model.AvailableMeters) { <option value="@meter.Id">@meter.MeterName (#@meter.Id)</option> }</select></label>
                <button class="utility-btn-primary" type="submit">Save meter link</button>
            </form>
        </section>
    }
    @if (TempData["NetworkSaved"] is string savedMessage) { <p class="alert alert-success" role="status">@savedMessage</p> }
    @if (User.IsInRole("Admin")) { <p><a class="utility-btn-primary" asp-page="./Edit">Edit network: add points and connections</a></p> }
    <div class="wn-summary">
        <section><span>01 / NETWORK</span><h2>@Model.Network.Nodes.Count points</h2><p>Meters, metered tanks and outlets in your saved network.</p></section>
        <section><span>02 / METERS</span><h2>@Model.LinkedMeters.Count assigned meters</h2><p>Linked points show their latest saved counter readings and capture dates.</p></section>
        <section><span>03 / SUPPLY</span><h2>@Model.Network.Connections.Count connections</h2><p>Normal supplies, transfers and conditional routes between points.</p></section>
    </div>

    <div class="wn-notice" role="note"><strong>Follow the supply:</strong> follow the arrows to see where the water goes. Select a point to see what supplies it and what it supplies next. Flow readings taken along the same route should not be added together as extra consumption.</div>

    <section class="content-card wn-explorer" aria-labelledby="network-heading">
        <div class="content-card-header">
            <div><h2 id="network-heading">Explore the flow</h2><p>View both stations together or focus on one. Select a point to follow its source and downstream branches.</p></div>
            <div class="wn-controls" hidden id="network-controls">
                <label for="network-station">Station <select id="network-station"><option value="All">Both stations</option><option value="Lower">Lower Station</option><option value="Top">Top Station</option></select></label>
                <label for="network-point">Show point <select id="network-point"></select></label>
                <label class="wn-checkbox"><input id="network-backup" type="checkbox" /> Highlight conditional supply routes</label>
            </div>
        </div>
        <div class="wn-explore-layout" id="network-explorer" hidden>
            <div>
                <div class="wn-legend"><span><i class="wn-key supply"></i> Water supply</span><span><i class="wn-key backup"></i> Conditional supply</span><span><i class="wn-key unknown"></i> Supply needs confirmation</span><button type="button" id="network-reset">Start of network</button></div>
                <div class="wn-canvas" tabindex="0" aria-label="Water network diagram, scroll horizontally to explore">
                    <svg id="network-diagram" role="group" aria-label="Interactive water network"></svg>
                </div>
                <p class="wn-caption">Flow shows the difference between cumulative readings allocated over the selected dates. Counter shows the latest saved reading by the end date. Highlighted connections show possible routes, not live valve status.</p>
            </div>
            <aside class="wn-details" aria-labelledby="selected-point-title">
                <span id="selected-point-kind" class="wn-eyebrow"></span>
                <h3 id="selected-point-title"></h3><p id="selected-point-note"></p>
                <div id="selected-point-routes" aria-live="polite"></div>
            </aside>
        </div>
        <noscript><p class="p-3">The complete connection list below is available without JavaScript.</p></noscript>
    </section>

    <details class="content-card wn-register"><summary>View all supply connections and saved meter readings</summary>
        <div class="content-card-header"><div><h2>All supply connections</h2><p>“View readings” opens saved readings for the verified meter at that point. “Meter not assigned” means that connection has not been set up yet.</p></div></div>
        @foreach (var warning in Model.MappingWarnings)
        {
            <p class="alert alert-warning" role="status">@warning</p>
        }
        <div class="table-wrap"><table class="utility-table">
            <thead><tr><th>Point</th><th>Station / role</th><th>Supplied by</th><th>Feeds</th><th>Meter history</th></tr></thead>
            <tbody>
            @foreach (var node in Model.Network.Nodes)
            {
                var incoming = Model.Network.Connections.Where(e => e.To == node.Id).ToList();
                var outgoing = Model.Network.Connections.Where(e => e.From == node.Id).ToList();
                <tr id="point-@node.Id">
                    <th scope="row">@node.Label<small>@node.Note</small></th>
                    <td>@node.Station / @Model.RoleLabel(node.Kind)</td>
                    <td>@if (incoming.Count == 0) { <span>@(node.Kind == "source" ? "Source" : "Feed to confirm")</span> }
                        @foreach (var edge in incoming) { <div><span>@names[edge.From]</span>@if (edge.Kind == "backup") { <small>When: @edge.Purpose @edge.Condition</small> }</div> }</td>
                    <td>@if (outgoing.Count == 0) { <span>@(node.Kind == "unresolved" ? "To confirm" : "No downstream point shown")</span> }
                        @foreach (var edge in outgoing) { <div><span>@names[edge.To]</span>@if (edge.Kind == "backup") { <small>When: @edge.Purpose @edge.Condition</small> }</div> }</td>
                    <td>@if (Model.LinkedMeters.TryGetValue(node.Id, out var meter))
                        { <a asp-page="/MeterReadings/History" asp-route-meterId="@meter.Id">View readings: @meter.MeterName</a><small>@(meter.IsActive ? "Active" : "Disabled")</small> }
                        else { <span>@(node.CanLinkMeter ? "Meter not assigned" : "No separate meter")</span> }</td>
                </tr>
            }
            </tbody>
        </table></div>
    </details>

</div>
@section Scripts {
    <script id="water-network-readings" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Latest))</script>
    <script id="water-network-traces" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.FlowTrace.Points.ToDictionary(p=>p.Id,p=>p.Sources.Select(s=>s.Path+(s.Conditional?" (conditional route)":"")).ToList())))</script>
    <script id="water-network-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Network, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }))</script>
    <script type="module" src="~/js/water-network.js" asp-append-version="true"></script>
}
