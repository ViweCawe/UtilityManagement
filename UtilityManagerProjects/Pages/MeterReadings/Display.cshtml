@page "{id:int}"
@model UtilityManagerProjects.Pages.MeterReadings.DisplayModel

@{
    ViewData["Title"] = "Meter Reading Detail";
}

<div class="page-shell">@if(Model.Reading?.ImportBatchId.HasValue == true){<p class="alert alert-info">Imported from @Model.Reading.ImportFileName · batch #@Model.Reading.ImportBatchId · physical meter #@Model.Reading.MeterId</p>}
    @if (Model.Reading?.IsBaseline == true) { <div class="alert alert-info">This is the baseline capture. It does not represent water flowing since zero. Capture a later counter reading to calculate interval flow.</div> }
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @if (Model.Reading != null)
    {
        <div class="page-header-row">
            <div class="page-title">
                <h1>Reading RDG-@Model.Reading.Id.ToString("0000")</h1>
                <p>Full details for this specific meter reading.</p>
                @if(Model.Reading.HasConvertedDisplay){<p>Meter counter: @Model.Reading.CurrentReading.ToString("#,##0.######") @Model.Reading.Unit × @Model.Reading.DisplayFactor.ToString("#,##0") = <strong>@Model.Reading.DisplayCurrentReading.ToString("#,##0.######") @Model.Reading.DisplayUnit</strong>. This is a cumulative counter equivalent.</p>}
            </div>

            <div class="page-actions">
                <a class="utility-btn-secondary"
                   asp-page="./History"
                   asp-route-meterId="@Model.Reading.MeterId">
                    <i class="bi bi-arrow-left"></i>
                    Back to Meter History
                </a>

                <a class="utility-btn-secondary" asp-page="./List">
                    <i class="bi bi-list"></i>
                    Latest Readings
                </a>
            </div>
        </div>

        <section class="stats-grid stats-grid-4">

            <div class="stat-card">
                <div class="stat-icon purple">
                    <i class="bi bi-speedometer2"></i>
                </div>
                <div class="stat-content">
                    <p>Meter</p>
                    <h2>
                        @if (!string.IsNullOrWhiteSpace(Model.Reading.MeterName))
                        {
                            @Model.Reading.MeterName
                        }
                        else
                        {
                            <span>Meter @Model.Reading.MeterId</span>
                        }
                    </h2>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon blue">
                    <i class="bi bi-tag-fill"></i>
                </div>
                <div class="stat-content">
                    <p>Meter Type</p>
                    <h2>@Model.Reading.MeterType</h2>
                    <span>@Model.Reading.DisplayUnit</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon green">
                    <i class="bi bi-graph-up"></i>
                </div>
                <div class="stat-content">
                    <p>Recorded flow / energy</p>
                    <h2>@Model.Reading.DisplayUsage.ToString("#,##0.######") <span>@Model.Reading.DisplayUnit</span></h2>
                    <span>calculated from previous to current</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon orange">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div class="stat-content">
                    <p>Reading Date</p>
                    <h2>@Model.Reading.ReadingDate.ToString("dd MMM")</h2>
                    <span>@Model.Reading.ReadingDate.ToString("yyyy HH:mm")</span>
                </div>
            </div>

        </section>

        <section class="grid-two">

            <div class="content-card">
                <div class="content-card-header">
                    <div>
                        <h3>Reading Details</h3>
                        <p>Meter, location, readings, and captured information.</p>
                    </div>
                </div>

                <div class="detail-list">

                    <div class="detail-row">
                        <span>Meter ID</span>
                        <strong>@Model.Reading.MeterId</strong>
                    </div>

                    <div class="detail-row">
                        <span>Meter Name</span>
                        <strong>
                            @if (!string.IsNullOrWhiteSpace(Model.Reading.MeterName))
                            {
                                @Model.Reading.MeterName
                            }
                            else
                            {
                                <span>Meter @Model.Reading.MeterId</span>
                            }
                        </strong>
                    </div>

                   
                    <div class="detail-row">
                        <span>Meter Type</span>
                        <strong>@Model.Reading.MeterType</strong>
                    </div>

                    <div class="detail-row">
                        <span>Area</span>
                        <strong>@Model.Reading.AreaName</strong>
                    </div>

                    <div class="detail-row">
                        <span>Station</span>
                        <strong>@Model.Reading.StationName</strong>
                    </div>

                    <div class="detail-row">
                        <span>Department</span>
                        <strong>@Model.Reading.DepartmentName</strong>
                    </div>

                    <div class="detail-row">
                        <span>Previous Reading</span>
                        <strong>@Model.Reading.DisplayPreviousReading.ToString("#,##0.######") @Model.Reading.DisplayUnit</strong>
                    </div>

                    <div class="detail-row">
                        <span>Current Reading</span>
                        <strong>@Model.Reading.DisplayCurrentReading.ToString("#,##0.######") @Model.Reading.DisplayUnit</strong>
                    </div>

                    <div class="detail-row">
                        <span>Recorded flow / energy</span>
                        <strong class="trend-positive">@Model.Reading.DisplayUsage.ToString("#,##0.######") @Model.Reading.DisplayUnit</strong>
                    </div>

                    <div class="detail-row">
                        <span>Captured By</span>
                        <strong>@Model.Reading.EmployeeEmail</strong>
                    </div>

                    <div class="detail-row">
                        <span>Last Updated By</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.Reading.UpdatedByEmployeeEmail)
                                ? "Not updated"
                                : Model.Reading.UpdatedByEmployeeEmail)
                        </strong>
                    </div>



                    <div class="detail-row">
                        <span>Notes</span>
                        <strong>
                            @if (!string.IsNullOrWhiteSpace(Model.Reading.Notes))
                            {
                                @Model.Reading.Notes
                            }
                            else
                            {
                                <span class="text-muted-custom">No notes</span>
                            }
                        </strong>
                    </div>

                </div>
            </div>

            <div class="content-card">
                <div class="content-card-header">
                    <div>
                        <h3>Update Reading</h3>
                        <p>Update the current reading and notes for this record.</p>
                    </div>
                </div>

                <form method="post" class="utility-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <input type="hidden" asp-for="ReadingUpdate.Id" />

                    <div class="form-group">
                        <label asp-for="ReadingUpdate.CurrentReadingUpdate">Counter as shown on the meter (@Model.Reading.Unit)</label>
                        <input asp-for="ReadingUpdate.CurrentReadingUpdate" type="number" step="0.000001" min="0" data-counter-entry data-fixed-meter="@Model.Reading.MeterId" data-counter-readout="counter-conversion" class="form-control utility-input" />
                        <span asp-validation-for="ReadingUpdate.CurrentReadingUpdate" class="text-danger"></span>
                        <p class="form-hint">Keep the number in the meter’s original unit; the litre display is calculated automatically.</p>
                        <output id="counter-conversion" class="form-hint" aria-live="polite"></output>
                        <script type="application/json" id="counter-unit-options">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<int,object>{[Model.Reading.MeterId]=new {Unit=Model.Reading.Unit,Factor=Model.Reading.DisplayFactor,DisplayUnit=Model.Reading.DisplayUnit}}))</script>
                    </div>

                    <div class="form-group">
                        <label asp-for="ReadingUpdate.ReadingDateUpdate"></label>
                        <input asp-for="ReadingUpdate.ReadingDateUpdate" class="form-control utility-input" type="datetime-local" />
                        <span asp-validation-for="ReadingUpdate.ReadingDateUpdate"></span>

                    </div>

                    <div class="form-group">
                        <label asp-for="ReadingUpdate.Notes"></label>
                        <textarea asp-for="ReadingUpdate.Notes" class="form-control utility-input" rows="5"></textarea>
                        <span asp-validation-for="ReadingUpdate.Notes" class="text-danger"></span>
                    </div>


                    <div class="form-actions">
                        <button type="submit" class="utility-btn-primary">
                            <i class="bi bi-save"></i>
                            Save Changes
                        </button>

                        <a class="utility-btn-secondary"
                           asp-page="./Delete"
                           asp-route-id="@Model.Reading.Id">
                            <i class="bi bi-trash"></i>
                            Delete Reading
                        </a>
                    </div>
                </form>
            </div>

        </section>
    }

</div>

@section Scripts {
<script type="module" src="~/js/reading-counter-preview.js" asp-append-version="true"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}