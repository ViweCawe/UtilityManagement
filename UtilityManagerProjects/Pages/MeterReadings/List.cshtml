@page
@model UtilityManagerProjects.Pages.MeterReadings.ListModel

@{
    ViewData["Title"] = "Meter Readings";
}

<div class="page-shell">

    <div class="page-header-row">
        <div class="page-title">
            <h1 style ="color:black ; font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif">Meter Readings</h1>
            <p>Latest water and electricity reading per meter. Showing @Model.DateRangeLabel.</p>
        </div>

        <div class="page-actions">
            <a class="utility-btn-secondary" href="#">
                <i class="bi bi-download"></i>
                Export
            </a>

            <a class="utility-btn-primary" asp-page="./Create">
                <i class="bi bi-plus-lg"></i>
                Add Reading
            </a>
        </div>
    </div>

    <form method="get" class="dashboard-filter-card">

        <div class="filter-group">
            <label>Date Range</label>
            <select name="DateFilter" class="utility-input" id="meterDateFilter">
                <option value="Last7" selected="@(Model.DateFilter == "Last7" ? "selected" : null)">Latest 7 Days</option>
                <option value="Last30" selected="@(Model.DateFilter == "Last30" ? "selected" : null)">Latest 30 Days</option>
                <option value="Custom" selected="@(Model.DateFilter == "Custom" ? "selected" : null)">Custom</option>
            </select>
        </div>

        <div class="filter-group meter-custom-date-filter" >
            <label>Start Date</label>
            <input type="date"
                   name="StartDate"
                   value="@(Model.StartDate?.ToString("yyyy-MM-dd") ?? Model.CurrentStart.ToString("yyyy-MM-dd"))"
                   class="utility-input" />
        </div>

        <div class="filter-group meter-custom-date-filter">
            <label>End Date</label>
            <input type="date"
                   name="EndDate"
                   value="@(Model.EndDate?.ToString("yyyy-MM-dd") ?? Model.CurrentEnd.ToString("yyyy-MM-dd"))"
                   class="utility-input" />
        </div>

        <div class="filter-group">
            <label>Search</label>
            <input type="search"
                   name="SearchTerm"
                   value="@Model.SearchTerm"
                   placeholder="Search meter, area, station..."
                   class="utility-input" />
        </div>

        <div class="filter-group">
            <label>Meter</label>
            <select name="MeterId" class="utility-input"><option value="">All meters</option>
                @foreach (var meter in Model.MeterOptions) { <option value="@meter.MeterId" selected="@(Model.MeterId == meter.MeterId ? "selected" : null)">@meter.MeterName (#@meter.MeterId)</option> }
            </select>
        </div>
        <div class="filter-group">
            <label>Department</label>
            <select name="Department" class="utility-input"><option value="">All departments</option>
                @foreach (var department in Model.DepartmentOptions) { <option value="@department" selected="@(Model.Department == department ? "selected" : null)">@department</option> }
            </select>
        </div>

        <div class="filter-actions">
            <button type="submit" class="utility-btn-primary">
                <i class="bi bi-funnel"></i>
                Apply
            </button>

            <a asp-page="./List" class="utility-btn-secondary">
                Clear
            </a>
        </div>

    </form>

    <section class="content-card">
        <div class="content-card-header"><div><h3>Daily Average by Meter</h3><p>Average consumption per calendar day in the selected period, even when readings were captured intermittently.</p></div></div>
        <div class="table-wrap"><table class="utility-table"><thead><tr><th>Meter</th><th>Department</th><th>Type</th><th>Readings</th><th>Total Usage</th><th>Daily Average</th></tr></thead><tbody>
        @foreach (var row in Model.DailyAverages) { <tr><td>@row.MeterName (#@row.MeterId)</td><td>@row.DepartmentName</td><td>@row.MeterType</td><td>@row.ReadingCount</td><td>@row.TotalUsage.ToString("N0") @row.Unit</td><td><strong>@row.DailyAverage.ToString("N1") @row.Unit/day</strong></td></tr> }
        @if (!Model.DailyAverages.Any()) { <tr><td colspan="6" class="empty-state">No readings found for this filter.</td></tr> }
        </tbody></table></div>
    </section>

    <section class="stats-grid stats-grid-4">

        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-droplet-fill"></i>
            </div>
            <div class="stat-content">
                <p>Water Readings</p>
                <h2>@Model.WaterCount.ToString("N0")</h2>
                <span class="@(Model.WaterPercent >= 0 ? "trend-positive" : "trend-negative")">
                    @(Model.WaterPercent >= 0 ? "▲" : "▼")
                    @Math.Abs(Model.WaterPercent).ToString("N1")% vs previous period
                </span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div class="stat-content">
                <p>Electricity Readings</p>
                <h2>@Model.ElectricityCount.ToString("N0")</h2>
                <span class="@(Model.ElectricityPercent >= 0 ? "trend-positive" : "trend-negative")">
                    @(Model.ElectricityPercent >= 0 ? "▲" : "▼")
                    @Math.Abs(Model.ElectricityPercent).ToString("N1")% vs previous period
                </span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon green">
                <i class="bi bi-speedometer2"></i>
            </div>
            <div class="stat-content">
                <p>Latest Meter Rows</p>
                <h2>@Model.TotalMeters.ToString("N0")</h2>
                <span>one latest row per meter</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon purple">
                <i class="bi bi-collection-fill"></i>
            </div>
            <div class="stat-content">
                <p>Total Readings</p>
                <h2>@Model.TotalReadings.ToString("N0")</h2>
                <span class="@(Model.TotalReadingsPercent >= 0 ? "trend-positive" : "trend-negative")">
                    @(Model.TotalReadingsPercent >= 0 ? "▲" : "▼")
                    @Math.Abs(Model.TotalReadingsPercent).ToString("N1")% vs previous period
                </span>
            </div>
        </div>

    </section>

    <section class="stats-grid stats-grid-3">

        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-water"></i>
            </div>
            <div class="stat-content">
                <p>Water Usage</p>
                <h2>@Model.WaterUsage.ToString("N0") <span>L</span></h2>
                <span>selected period</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="bi bi-lightning"></i>
            </div>
            <div class="stat-content">
                <p>Electricity Usage</p>
                <h2>@Model.ElectricityUsage.ToString("N0") <span>kWh</span></h2>
                <span>selected period</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon purple">
                <i class="bi bi-bar-chart-fill"></i>
            </div>
            <div class="stat-content">
                <p>Total Usage</p>
                <h2>@Model.TotalUsage.ToString("N0")</h2>
                <span>water + electricity usage</span>
            </div>
        </div>

    </section>

    <section class="content-card">

        <div class="content-card-header">
            <div>
                <h3>Latest Reading Per Meter</h3>
                <p>Click the meter name to view all readings for that meter. Click the eye icon to view that specific reading.</p>
            </div>
        </div>

        <div class="table-wrap">
            <table class="utility-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Meter</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th>Station</th>
                        <th>Department</th>
                        <th>Reading Date</th>
                        <th>Previous Reading</th>
                        <th>Current Reading</th>
                        <th>Usage</th>
                        <th>Captured By</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.LatestReadings.Any())
                    {
                        @foreach (var reading in Model.LatestReadings)
                        {
                            var unit = Model.GetMeterUnit(reading.MeterType);

                            var pillClass = reading.MeterType == DataLibrary.Models.MeterType.Water
                                ? "reading-water"
                                : "reading-electricity";

                            var meterName = !string.IsNullOrWhiteSpace(reading.MeterName)
                                ? reading.MeterName
                                : $"Meter {reading.MeterNameWithUnit}";

                            <tr>
                                <td>RDG-@reading.Id.ToString("0000")</td>

                                <td>
                                    <a class="table-main-link"
                                       asp-page="./History"
                                       asp-route-meterId="@reading.MeterId">
                                        @reading.MeterName
                                    </a>

                                    <span class="table-subtext">
                                         @reading.MeterNameWithUnit
                                    </span>
                                </td>

                                <td>
                                    <span class="reading-pill @pillClass">
                                        @reading.MeterType
                                    </span>
                                </td>

                                <td>@reading.AreaName</td>
                                <td>@reading.StationName</td>
                                <td>@reading.DepartmentName</td>

                                <td>
                                    <div class="table-date">
                                        <strong>@reading.ReadingDate.ToString("dd MMM yyyy")</strong>
                                        <span>@reading.ReadingDate.ToString("HH:mm")</span>
                                    </div>
                                </td>

                                <td>@reading.PreviousReading.ToString("N0") @unit</td>
                                <td>@reading.CurrentReading.ToString("N0") @unit</td>

                                <td class="trend-positive">
                                    @reading.Usage.ToString("N0") @unit
                                </td>

                                <td>@reading.EmployeeEmail</td>

                                <td>
                                    <div class="action-buttons">
                                        <a class="icon-action"
                                           asp-page="./History"
                                           asp-route-meterId="@reading.MeterId"
                                           title="View Meter History">
                                            <i class="bi bi-clock-history"></i>
                                        </a>

                                        <a class="icon-action"
                                           asp-page="./Display"
                                           asp-route-id="@reading.Id"
                                           title="View Reading Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a class="icon-action"
                                           asp-page="./Edit"
                                           asp-route-id="@reading.Id"
                                           title="Edit Reading">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a class="icon-action danger"
                                           asp-page="./Delete"
                                           asp-route-id="@reading.Id"
                                           title="Delete Reading">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="empty-state">
                                No meter readings found for the selected filter.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </section>

</div>

@section Scripts {
    <script>
        const meterDateFilter = document.getElementById('meterDateFilter');
        const meterCustomDateFilters = document.querySelectorAll('.meter-custom-date-filter');

        function toggleMeterCustomDates() {
            const showCustom = meterDateFilter.value === 'Custom';

            meterCustomDateFilters.forEach(item => {
                item.style.display = showCustom ? 'flex' : 'none';
            });
        }

        meterDateFilter.addEventListener('change', toggleMeterCustomDates);
        toggleMeterCustomDates();
    </script>
}
