@page
@model UtilityManagerProjects.Pages.MeterReadings.ListModel
@{
}
<div class="dashboard-container">
    <h3>Readings</h3>
    <p>Manage and monitor all utitlity readings</p>
<div class="row g-4 mb-4">

    @foreach (var kpi in Model.MeterTypeKpis)
    {
        <div class="col-md-4">
            <div class="kpi-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <div class="kpi-title">
                            @kpi.MeterType
                        </div>

                        <div class="kpi-value">
                            @kpi.Current7Days
                        </div>
                    </div>

                       

                    <div class="kpi-icon">
                        <i class="bi bi-speedometer2"></i>
                    </div>

                </div>

                    

                <div class="mt-3">

                    @if (kpi.WeeklyGrowthPercent >= 0)
                    {
                        <span class="growth-up">
                            ▲ @kpi.WeeklyGrowthPercent.ToString("0.0")%
                        </span>
                    }
                    else
                    {
                        <span class="growth-down">
                            ▼ @Math.Abs(kpi.WeeklyGrowthPercent).ToString("0.0")%
                        </span>
                    }

                    <span class="growth-text">
                        vs previous week
                    </span>

                </div>
                    
            </div>
        </div>
    }

</div>
<div class="table-container">
<h3>Meter Readings</h3>
<div class="table-card">
<table class="table table-hover mb-0">
    <thead class="text-white">
        <tr>
            <th>Id</th>
            <th>Meter Name</th>
            <th>Type</th>
            <th>Location</th>
            <th>Reading Date</th>
            <th>Previouse Reading</th>
            <th>Current Reading</th>
            <th>Usage</th>
            <th>Recorded By</th>
            <th>Actions</th>
            
            
        </tr>
    </thead>
    <tbody>
        @foreach (var reading in Model.MeterReadings)
        {
            <tr>
                <td>@reading.Id</td>
                <td>@reading.MeterName
                </td>
                
                            
                           <td>
                                <span class="meter-tag @reading.MeterType">
                                    @reading.MeterType
                                </span>
                            </td>
                <td>@reading.AreaName
                </td>
                <td>@reading.ReadingDate.ToString("MM/dd/yyyy")</td>
                <td>@reading.PreviousReading @reading.Unit</td>
                <td>@reading.CurrentReading @reading.Unit</td>
                <td>@reading.Usage @reading.Unit </td>
                <td>@reading.EmployeeId</td>
                            <td class="action-cell">

                                <a asp-page="./Display"
                                   asp-route-id="@reading.Id"
                                   class="btn-action details"
                                   title="Details">

                                    <i class="bi bi-eye-fill"></i>
                                </a>

                                <a asp-page="./Delete"
                                   asp-route-id="@reading.Id"
                                   class="btn-action delete"
                                   title="Delete">

                                    <i class="bi bi-trash-fill"></i>
                                </a>

                            </td>
            </tr>
        }
    </tbody>
      </table>
  </div>
</div>
</div>