@page
@model UtilityManagerProjects.Pages.MeterReadings.CreateModel
@{
    ViewData["Title"] = "Create Meter Reading";
}
<div class="page-shell form-page-shell">
    <div class="page-header-row">
        <div class="page-title">
            <h1>Create Meter Reading</h1>
            <p>Capture a new water or electricity meter reading.</p>
        </div>
        <div class="page-actions">
            <a class="utility-btn-secondary" asp-page="./List">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>
    <section class="content-card form-card">
        <div class="content-card-header">
            <div><h3>Waste Reading Information</h3><p>Complete the required fields.</p></div>
            <div class="form-card-icon blue"><i class="bi bi-speedometer2"></i></div>
        </div>
        <form method="post" class="utility-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="form-grid">
                <div class="form-group form-group-full">
                    <label asp-for="Input.MeterId">Meter</label>
                    <select asp-for="Input.MeterId" asp-items="Model.MeterItems" class="utility-input">
                        <option value="">Select Meter</option>
                    </select>
                    <span asp-validation-for="Input.MeterId" class="field-validation"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.CurrentReading">Current Reading</label>
                    <input asp-for="Input.CurrentReading" class="utility-input" type="number" min="0" step="0.01" />
                    <span asp-validation-for="Input.CurrentReading" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ReadingDate">Reading Date</label>
                    <input asp-for="Input.ReadingDate" class="utility-input" type="datetime-local" />
                    <span asp-validation-for="Input.ReadingDate" class="field-validation"></span>
                </div>
                <div class="form-group form-group-full">
                    <label asp-for="Input.Notes">Notes</label>
                    <textarea asp-for="Input.Notes" class="utility-input utility-textarea" rows="5"></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="utility-btn-primary">
                    <i class="bi bi-check-lg"></i> Save Meter Reading
                </button>
                <a asp-page="./List" class="utility-btn-secondary">Cancel</a>
            </div>
        </form>
    </section>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
