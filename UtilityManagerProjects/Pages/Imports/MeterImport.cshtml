@page
@model UtilityManagerProjects.Pages.Imports.MeterImportModel
@{ ViewData["Title"]="Import meter readings"; }
<div class="page-shell"><div class="page-header-row"><div class="page-title"><h1>Import meter readings</h1><p>Review historical counters before adding them. Replaced meters keep their own IDs and original units.</p></div><a asp-page="/Meters/Index" class="utility-btn-secondary">Meter register</a></div>
 <section class="content-card"><h2>1. Prepare the spreadsheet</h2><p>Use one row per actual capture with columns <strong>MeterId, ReadingDate, Counter, Unit</strong>. Dates: yyyy-MM-dd or yyyy-MM-ddTHH:mm:ss. Use a decimal point without thousands separators. The first XLSX worksheet is read.</p><p>For the older wide workbook, reshape each meter column into these rows. Use the old meter ID before replacement and the new ID afterward. Import actual counter captures, not calculated usage, weekly averages, formulas or carried-forward blanks.</p><a asp-page-handler="Template" class="utility-btn-secondary">Download CSV template</a><p class="form-hint">Water units: L, kL, m³ (m3 is accepted). m² is area and cannot be imported as water volume.</p></section>
 <section class="content-card"><h2>2. Upload and check</h2><form method="post" enctype="multipart/form-data" asp-page-handler="Preview"><label asp-for="Upload">CSV / XLSX file</label><input asp-for="Upload" type="file" accept=".csv,.xlsx" class="utility-input" required /><button class="utility-btn-primary">Preview readings</button></form></section>
 @if(!string.IsNullOrEmpty(Model.Message)){<p class="alert alert-info" role="status">@Model.Message</p>}
 @if(Model.Checks.Count>0){<section class="content-card"><h2>3. Review @Model.Checks.Count captures</h2><p>@Model.Checks.Count(c=>c.Status=="New") new · @Model.Checks.Count(c=>c.Status=="Existing") existing · @Model.Checks.Count(c=>c.Status=="Error") errors</p><div class="table-wrap"><table class="utility-table"><thead><tr><th>Physical meter</th><th>Capture</th><th>Counter</th><th>Unit</th><th>Status</th><th>Check</th></tr></thead><tbody>@foreach(var c in Model.Checks.OrderBy(c=>c.Status=="Error"?0:1).Take(200)){<tr><td>#@c.Reading.MeterId</td><td>@c.Reading.ReadingDate.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@c.Reading.Counter</td><td>@c.Reading.Unit</td><td>@c.Status</td><td>@c.Detail</td></tr>}</tbody></table></div><p class="form-hint">Showing up to 200 checks, with errors first. Any error blocks the entire batch; no existing reading is overwritten.</p></section>}
 @if(!string.IsNullOrEmpty(Model.PreviewToken)&&Model.Checks.All(c=>c.Status!="Error")){<form method="post" asp-page-handler="Confirm" class="content-card"><input type="hidden" asp-for="PreviewToken" /><button class="utility-btn-primary">Import reviewed readings</button><p class="form-hint">The preview expires after 15 minutes. The entire batch is checked again when saved.</p></form>}
</div>
