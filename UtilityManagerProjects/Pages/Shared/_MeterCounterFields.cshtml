@* Shared field names bind to Input on both meter forms. *@
<div class="meter-field"><label for="Input_CounterUnit">Counter unit</label><select name="Input.CounterUnit" id="Input_CounterUnit" class="utility-input">
@foreach(var unit in new[]{"L","m³","kL","kWh"}){<option value="@unit" selected="@(ViewData["CounterUnit"]?.ToString()==unit)">@unit</option>}
<option disabled>m² · square metres (area, not water volume)</option></select><p class="form-hint">Enter the unit printed on the physical counter. Water: 1 m³ = 1 kL = 1,000 L. Reports compare water in litres.</p>@Html.ValidationMessage("Input.CounterUnit",null,new { @class="text-danger" })</div>
<div class="meter-field"><label for="Input_SerialNumber">Serial / physical meter number</label><input id="Input_SerialNumber" name="Input.SerialNumber" value="@ViewData["SerialNumber"]" maxlength="100" class="utility-input" />@Html.ValidationMessage("Input.SerialNumber",null,new { @class="text-danger" })</div>
<div class="meter-field"><label for="Input_FlowDirection">Measurement direction</label><select name="Input.FlowDirection" id="Input_FlowDirection" class="utility-input">
@foreach(var direction in Enum.GetValues<DataLibrary.Models.MeterFlowDirection>()){<option value="@((int)direction)" selected="@(ViewData["FlowDirection"]?.ToString()==direction.ToString())">@direction</option>}
</select><p class="form-hint">Inlet measures water entering this boundary. Outlet measures water leaving it. A tank outlet transfer is not automatically consumption.</p>@Html.ValidationMessage("Input.FlowDirection",null,new { @class="text-danger" })</div>
<div class="meter-field"><label for="Input_InstalledOn">Installed / replacement cutover</label><input name="Input.InstalledOn" id="Input_InstalledOn" type="datetime-local" step="1" value="@ViewData["InstalledOn"]" class="utility-input" /><p class="form-hint">For a replacement, this is when the old meter stops and the new meter starts. Capture the old final and new starting counters separately.</p>@Html.ValidationMessage("Input.InstalledOn",null,new { @class="text-danger" })</div>
