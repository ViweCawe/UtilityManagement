@model IReadOnlyList<UtilityManagerProjects.Models.MeterDailyAverageRow>
<section class="content-card" aria-labelledby="meter-averages-title">
 <div class="content-card-header"><div><h2 id="meter-averages-title">Daily average by meter</h2><p>For the selected dates, meter and department. Each average uses that meter’s covered days.</p></div></div>
 <div class="table-wrap"><table class="utility-table"><caption class="visually-hidden">Estimated per-meter daily flow. Downstream meters overlap; do not add these rows as site supply.</caption><thead><tr><th>Meter</th><th>Department</th><th>Type</th><th>Latest saved counter</th><th>Captured readings</th><th>Estimated flow</th><th>Covered days</th><th>Daily average</th></tr></thead><tbody>
 @foreach(var row in Model) { <tr><td><a asp-page="/MeterReadings/History" asp-route-meterId="@row.MeterId">@row.MeterName</a><small class="table-subtext d-block">@row.CalculationStatus</small></td><td>@row.DepartmentName</td><td>@row.MeterType</td><td><strong>@(row.LatestCounter?.ToString("N0")??"—") @row.Unit</strong><small class="table-subtext d-block">@(row.LatestCounterDate?.ToString("dd MMM yyyy")??"No capture")</small></td><td>@row.ReadingCount</td><td>@(row.CoveredDays>0?row.TotalUsage.ToString("N1"):"—") @row.Unit</td><td>@row.CoveredDays</td><td><strong>@(row.CoveredDays>0?row.DailyAverage.ToString("N1"):"—") @row.Unit/day</strong></td></tr> }
 @if(!Model.Any()) { <tr><td colspan="8" class="empty-state">No meters match these filters.</td></tr> }
 </tbody></table></div>
 <p class="form-hint">Latest counters are shown on or before the selected end date. Counters are cumulative; they are not period usage. These are estimated meter flows. Parent and child meters overlap and must not be added together.</p>
</section>
