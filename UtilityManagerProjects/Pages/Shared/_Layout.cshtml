@{
    var isIdentityPage =
        Context.Request.Path.StartsWithSegments("/Identity");

    var hideSidebar =
        ViewData["HideSidebar"] as bool? == true ||
        isIdentityPage;

    var title =
        ViewData["Title"]?.ToString()
        ?? "Utility Manager";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@title - Utility Manager</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/UtilityManagerProjects.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<link rel="stylesheet"
          href="~/css/StyleSheet.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Utility-ui.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/app-theme.css" asp-append-version="true" />
</head>

<body class="utility-body @(hideSidebar ? "no-sidebar-page" : "")">

    <a class="skip-link" href="#main-content">Skip to content</a>
    @if (hideSidebar)
    {
        <main id="main-content" class="utility-public-main">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="utility-shell">

            <partial name="_UtilitySidebar" />

            <main id="main-content" class="utility-main">
                @RenderBody()
            </main>

        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="~/js/app-navigation.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
