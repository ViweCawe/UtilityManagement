@page
@model UtilityManagerProjects.Pages.MeterMapping.IndexModel
@{
    ViewData["Title"] = "Meter Mapping";
}
<h1>Meter Mapping</h1>
<p>Admin-only meter hierarchy. Reassign a child by saving it under a new parent; historical connections are retained.</p>
@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}
<div asp-validation-summary="All" class="text-danger"></div>
<form method="post" asp-page-handler="Save" class="card card-body mb-4">
    <label asp-for="UpstreamMeterId">Parent meter</label>
    <select asp-for="UpstreamMeterId" class="form-select mb-3">
        <option value="">Select parent</option>
        @foreach (var meter in Model.AvailableMeters)
        {
            <option value="@meter.Id">@meter.MeterName (@meter.MeterType)</option>
        }
    </select>
    <label asp-for="DownstreamMeterId">Child meter</label>
    <select asp-for="DownstreamMeterId" class="form-select mb-3">
        <option value="">Select child</option>
        @foreach (var meter in Model.AvailableMeters)
        {
            <option value="@meter.Id">@meter.MeterName (@meter.MeterType)</option>
        }
    </select>
    <button type="submit" class="btn btn-primary">Save connection</button>
</form>
<h2>Active connections</h2>
<table class="table">
    <thead><tr><th>Parent</th><th>Child</th><th>Action</th></tr></thead>
    <tbody>
    @foreach (var connection in Model.ActiveConnections)
    {
        <tr>
            <td>@Model.NameOf(connection.UpstreamMeterId)</td>
            <td>@Model.NameOf(connection.DownstreamMeterId)</td>
            <td>
                <form method="post" asp-page-handler="Disconnect">
                    <input type="hidden" name="downstreamMeterId" value="@connection.DownstreamMeterId" />
                    <button type="submit" class="btn btn-outline-danger btn-sm">Disconnect</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
