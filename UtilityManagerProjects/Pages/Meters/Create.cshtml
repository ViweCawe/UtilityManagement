@page
@model UtilityManagerProjects.Pages.Meters.CreateModel
@using DataLibrary.Models

@{
    ViewData["Title"] = "Add Meter";
}

<style>
    .meter-create-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 300px;
        gap: 24px;
        align-items: start;
    }

    .meter-form-card,
    .meter-help-panel {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
    }

    .meter-form-card {
        padding: 28px;
    }

    .meter-form-section + .meter-form-section {
        margin-top: 28px;
        padding-top: 28px;
        border-top: 1px solid #e5e7eb;
    }

    .meter-form-section h2,
    .meter-help-panel h2 {
        margin: 0 0 6px;
        color: #111827;
        font-size: 1rem;
        font-weight: 700;
    }

    .meter-form-section > p,
    .meter-help-panel p {
        margin: 0 0 20px;
        color: #6b7280;
        font-size: .9rem;
        line-height: 1.55;
    }

    .meter-field {
        margin-top: 20px;
    }

    .meter-label,
    .meter-field > label:first-child {
        display: block;
        margin-bottom: 8px;
        color: #374151;
        font-size: .875rem;
        font-weight: 600;
    }

    .meter-required {
        color: #dc2626;
    }

    .meter-input,
    .meter-select {
        width: 100%;
        min-height: 44px;
        padding: 10px 12px;
        color: #111827;
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        outline: none;
    }

    .meter-input:focus,
    .meter-select:focus {
        border-color: #6d5bd0;
        box-shadow: 0 0 0 3px rgba(109, 91, 208, .14);
    }

    .meter-type-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .meter-type-option {
        position: relative;
        display: flex;
        gap: 12px;
        align-items: center;
        min-height: 76px;
        padding: 14px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        cursor: pointer;
    }

    .meter-type-option:has(input:checked) {
        border-color: #6d5bd0;
        background: #f7f5ff;
        box-shadow: 0 0 0 1px #6d5bd0;
    }

    .meter-type-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .meter-type-icon {
        display: grid;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        place-items: center;
        border-radius: 50%;
        font-size: 1.15rem;
    }

    .meter-type-icon.water {
        color: #0369a1;
        background: #e0f2fe;
    }

    .meter-type-icon.electricity {
        color: #b45309;
        background: #fef3c7;
    }

    .meter-type-copy strong,
    .meter-type-copy span {
        display: block;
    }

    .meter-type-copy strong {
        color: #111827;
        font-size: .9rem;
    }

    .meter-type-copy span {
        margin-top: 3px;
        color: #6b7280;
        font-size: .8rem;
    }

    .meter-toggle-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        align-items: center;
        padding: 16px;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
    }

    .meter-toggle-row strong,
    .meter-toggle-row span {
        display: block;
    }

    .meter-toggle-row strong {
        color: #374151;
        font-size: .875rem;
    }

    .meter-toggle-row span {
        margin-top: 3px;
        color: #6b7280;
        font-size: .8rem;
    }

    .meter-toggle-row input {
        width: 18px;
        height: 18px;
        accent-color: #6d5bd0;
    }

    .meter-form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 28px;
        padding-top: 24px;
        border-top: 1px solid #e5e7eb;
    }

    .meter-help-panel {
        padding: 22px;
    }

    .meter-help-list {
        display: grid;
        gap: 16px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .meter-help-list li {
        display: flex;
        gap: 10px;
        color: #4b5563;
        font-size: .85rem;
        line-height: 1.45;
    }

    .meter-help-list i {
        margin-top: 2px;
        color: #6d5bd0;
    }

    .field-validation-error,
    .validation-summary-errors {
        color: #b91c1c;
        font-size: .8rem;
    }

    .field-validation-error {
        display: block;
        margin-top: 6px;
    }

    .validation-summary-errors {
        margin-bottom: 20px;
        padding: 12px 14px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 6px;
    }

    .validation-summary-errors ul {
        margin: 0;
        padding-left: 18px;
    }

    @@media (max-width: 900px) {
        .meter-create-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .meter-form-card {
            padding: 20px;
        }

        .meter-type-grid {
            grid-template-columns: 1fr;
        }

        .meter-form-actions {
            flex-direction: column-reverse;
        }

        .meter-form-actions .utility-btn-primary,
        .meter-form-actions .utility-btn-secondary {
            justify-content: center;
            width: 100%;
        }
    }
</style>

<div class="page-shell">
    <div class="page-header-row">
        <div class="page-title">
            <h1>Add Meter</h1>
            <p>Register a water or electricity meter at a mapped location.</p>
        </div>

        <div class="page-actions">
            <a class="utility-btn-secondary" asp-page="./Index">
                <i class="bi bi-arrow-left"></i>
                Back to Meters
            </a>
        </div>
    </div>

    <div class="meter-create-layout">
        <form method="post" class="meter-form-card">
            <div asp-validation-summary="ModelOnly"></div>

            <section class="meter-form-section">
                <h2>Meter Details</h2>
                <p>Enter the meter's identifying information and utility type.</p>

                <div class="meter-field">
                    <label asp-for="Input.MeterName">
                        Meter name <span class="meter-required">*</span>
                    </label>
                    <input asp-for="Input.MeterName"
                           class="meter-input"
                           placeholder="e.g. Main Building Water Meter"
                           autocomplete="off" />
                    <span asp-validation-for="Input.MeterName"></span>
                </div>

                <fieldset class="meter-field border-0 p-0 m-0">
                    <legend class="meter-label">
                        Meter type <span class="meter-required">*</span>
                    </legend>

                    <div class="meter-type-grid">
                        <label class="meter-type-option">
                            <input asp-for="Input.MeterType" type="radio" value="@MeterType.Water" />
                            <span class="meter-type-icon water">
                                <i class="bi bi-droplet-fill"></i>
                            </span>
                            <span class="meter-type-copy">
                                <strong>Water</strong>
                                <span>Usage recorded in litres</span>
                            </span>
                        </label>

                        <label class="meter-type-option">
                            <input asp-for="Input.MeterType" type="radio" value="@MeterType.Electricity" />
                            <span class="meter-type-icon electricity">
                                <i class="bi bi-lightning-charge-fill"></i>
                            </span>
                            <span class="meter-type-copy">
                                <strong>Electricity</strong>
                                <span>Usage recorded in kWh</span>
                            </span>
                        </label>
                    </div>
                    <span asp-validation-for="Input.MeterType"></span>
                </fieldset>
            </section>

            <section class="meter-form-section">
                <h2>Placement</h2>
                <p>Select the area, department, and station where the meter is installed.</p>

                <div class="meter-field">
                    <label asp-for="Input.AreaId">
                        Area <span class="meter-required">*</span>
                    </label>
                    <select asp-for="Input.AreaId"
                            asp-items="Model.AreaOptions"
                            class="meter-select">
                        <option value="0">Select an area</option>
                    </select>
                    <span asp-validation-for="Input.AreaId"></span>
                </div>

                <div class="meter-field">
                    <label asp-for="Input.DepartmentId">
                        Department <span class="meter-required">*</span>
                    </label>
                    <select asp-for="Input.DepartmentId"
                            asp-items="Model.DepartmentOptions"
                            class="meter-select">
                        <option value="0">Select a department</option>
                    </select>
                    <span asp-validation-for="Input.DepartmentId"></span>
                </div>

                <div class="meter-field">
                    <label asp-for="Input.StationId">
                        Station <span class="meter-required">*</span>
                    </label>
                    <select asp-for="Input.StationId"
                            asp-items="Model.StationOptions"
                            class="meter-select">
                        <option value="0">Select a station</option>
                    </select>
                    <span asp-validation-for="Input.StationId"></span>
                </div>
            </section>

            <section class="meter-form-section">
                <h2>Reading Behaviour</h2>
                <p>Choose how readings for this meter should be interpreted.</p>

                <label class="meter-toggle-row">
                    <span>
                        <strong>Cumulative meter</strong>
                        <span>New readings represent a running total.</span>
                    </span>
                    <input asp-for="Input.IsCumulative" />
                </label>
            </section>

            <div class="meter-form-actions">
                <a class="utility-btn-secondary" asp-page="./Index">Cancel</a>
                <button type="submit" class="utility-btn-primary">
                    <i class="bi bi-check-lg"></i>
                    Create Meter
                </button>
            </div>
        </form>

        <aside class="meter-help-panel">
            <h2>Before You Start</h2>
            <p>Check these details to keep meter records accurate.</p>

            <ul class="meter-help-list">
                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Use a clear name that identifies the building, floor, or supply point.</span>
                </li>
                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Confirm the utility type because it determines the unit of measure.</span>
                </li>
                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Confirm the meter's area, department, and station before saving.</span>
                </li>
            </ul>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
