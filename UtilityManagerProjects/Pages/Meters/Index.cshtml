@page
@model UtilityManagerProjects.Pages.Meters.IndexModel

@{
    ViewData["Title"] = "Meters";
}

<div class="page-shell">

    <div class="page-header-row">
        <div class="page-title">
            <h1>Meters</h1>
            <p>Manage water and electricity meters across locations.</p>
        </div>

        <div class="page-actions">
            <a class="utility-btn-secondary" href="#">
                <i class="bi bi-download"></i>
                Export
            </a>

            <a class="utility-btn-primary" asp-page="./Create">
                <i class="bi bi-plus-lg"></i>
                Add Meter
            </a>
        </div>
    </div>

    <section class="stats-grid stats-grid-3">

        <div class="stat-card">
            <div class="stat-icon purple">
                <i class="bi bi-speedometer2"></i>
            </div>
            <div class="stat-content">
                <p>Total Meters</p>
                <h2>@Model.TotalCount.ToString("N0")</h2>
                <span>registered meters</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-droplet-fill"></i>
            </div>
            <div class="stat-content">
                <p>Water Meters</p>
                <h2>@Model.WaterCount.ToString("N0")</h2>
                <span>@Model.WaterPercent% of all meters</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div class="stat-content">
                <p>Electricity Meters</p>
                <h2>@Model.ElectricityCount.ToString("N0")</h2>
                <span>@Model.ElectricityPercent% of all meters</span>
            </div>
        </div>

    </section>

    <section class="content-card">

        <div class="content-card-header">
            <div>
                <h3>All Meters</h3>
                <p>Water and electricity meter register.</p>
            </div>

            <div class="toolbar">
                <input class="search-box" type="search" placeholder="Search meters..." />
            </div>
        </div>

        <div class="table-wrap">
            <table class="utility-table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Meter ID</th>
                        <th>Meter Name</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.MeterRows.Any())
                    {
                        @foreach (var meter in Model.MeterRows)
                        {
                            var pillClass = $"reading-{meter.MeterType.ToLower()}";

                            <tr>
                                <td>@meter.MeterName</td>
                                <td>@meter.MeterId</td>
                                <td>
                                    <span class="reading-pill @pillClass">
                                        @meter.MeterType
                                    </span>
                                </td>
                                <td>
                                    <span class="reading-pill reading-waste">
                                        @meter.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a class="icon-action" href="#">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a class="icon-action" href="#">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a class="icon-action" href="#">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="empty-state">
                                No meters have been added yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </section>

</div>