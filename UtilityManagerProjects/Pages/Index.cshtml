@page
@model IndexModel
@{ ViewData["Title"]="Utility Manager"; ViewData["HideSidebar"]=true; }
<div class="simple-landing">
 <header class="simple-landing-header"><a asp-page="/Index" class="simple-brand"><i class="bi bi-droplet-fill" aria-hidden="true"></i> Utility Manager</a><partial name="_LoginPartial" /></header>
 <section class="simple-hero" aria-labelledby="welcome-title">
  <span class="landing-label">Table Mountain Aerial Cableway</span>
  <h1 id="welcome-title">Keep track of your utilities.</h1>
  <p>Record readings, follow water flow and review usage in one place.</p>
  @if(User.Identity?.IsAuthenticated==true) {
   <div class="landing-actions"><a asp-page="/Dashboard/Dashboard" class="utility-btn-primary">Open Dashboard <i class="bi bi-arrow-right" aria-hidden="true"></i></a><a asp-page="/MeterReadings/Create" class="utility-btn-secondary">Record a reading</a></div>
  } else {
   <a asp-area="Identity" asp-page="/Account/Login" class="utility-btn-primary">Sign in <i class="bi bi-arrow-right" aria-hidden="true"></i></a><p class="form-hint">Need access? Ask your administrator for an account.</p>
  }
 </section>
 <section class="landing-features" aria-label="What you can do">
  <article><i class="bi bi-journal-text" aria-hidden="true"></i><h2>Record</h2><p>Capture meter readings and waste records.</p></article>
  <article><i class="bi bi-diagram-3" aria-hidden="true"></i><h2>Understand</h2><p>See how water flows through your network.</p></article>
  <article><i class="bi bi-bar-chart-line" aria-hidden="true"></i><h2>Review</h2><p>Compare daily averages and export reports.</p></article>
 </section>
 <footer class="simple-footer">Utility Management</footer>
</div>
