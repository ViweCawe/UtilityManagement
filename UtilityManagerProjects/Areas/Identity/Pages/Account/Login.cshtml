@page
@model LoginModel
@{ ViewData["Title"]="Sign in"; }
<div class="auth-shell">
 <section class="auth-card" aria-labelledby="signin-title">
  <h1 id="signin-title">Utility Manager</h1>
  <p>Sign in to record readings and review usage.</p>
  <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl" class="utility-form">
   <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
   <div class="form-group"><label asp-for="Input.Email">Email address</label><input asp-for="Input.Email" class="utility-input" autocomplete="username" aria-required="true"/><span asp-validation-for="Input.Email" class="text-danger"></span></div>
   <div class="form-group"><label asp-for="Input.Password"></label><input asp-for="Input.Password" class="utility-input" autocomplete="current-password" aria-required="true"/><span asp-validation-for="Input.Password" class="text-danger"></span></div>
   <label class="check-row"><input asp-for="Input.RememberMe"/> Remember me</label>
   <div class="form-actions"><button id="login-submit" type="submit" class="utility-btn-primary">Sign in</button><a asp-page="./ForgotPassword">Forgot password?</a></div>
  </form>
  <p class="form-hint">Need an account? Contact your administrator.</p>
  @if((Model.ExternalLogins?.Count??0)>0) {
   <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-actions">
    @foreach(var provider in Model.ExternalLogins!) { <button type="submit" class="utility-btn-secondary" name="provider" value="@provider.Name">Sign in with @provider.DisplayName</button> }
   </form>
  }
 </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
