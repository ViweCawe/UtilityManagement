@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Reset password";
}

<div class="auth-shell">
    <section class="auth-card auth-card-compact">

        <div class="auth-brand auth-brand-centered">
            <div class="auth-brand-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div>
                <h1>Reset your password</h1>
                <p>Create a new secure password for your account.</p>
            </div>
        </div>

        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly"
                 class="auth-validation-summary"
                 role="alert"></div>

            <input asp-for="Input.Code" type="hidden" />

            <div class="auth-form-group">
                <label asp-for="Input.Email">Email address</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Input.Email"
                           class="auth-input"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Input.Email"
                      class="auth-field-validation"></span>
            </div>

            <div class="auth-form-group">
                <label asp-for="Input.Password">New password</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Input.Password"
                           class="auth-input"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Enter a new password" />
                </div>
                <span asp-validation-for="Input.Password"
                      class="auth-field-validation"></span>
            </div>

            <div class="auth-form-group">
                <label asp-for="Input.ConfirmPassword">
                    Confirm new password
                </label>
                <div class="auth-input-wrap">
                    <i class="bi bi-shield-check"></i>
                    <input asp-for="Input.ConfirmPassword"
                           class="auth-input"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Repeat the new password" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword"
                      class="auth-field-validation"></span>
            </div>

            <button type="submit" class="auth-primary-btn">
                <i class="bi bi-check-circle-fill"></i>
                Reset password
            </button>

            <div class="auth-footer-links">
                <a asp-page="./Login">
                    <i class="bi bi-arrow-left"></i>
                    Back to login
                </a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
