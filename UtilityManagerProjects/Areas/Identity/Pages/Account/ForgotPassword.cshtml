@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-shell">
    <section class="auth-card auth-card-compact">

        <div class="auth-brand auth-brand-centered">
            <div class="auth-brand-icon">
                <i class="bi bi-key-fill"></i>
            </div>
            <div>
                <h1>Forgot your password?</h1>
                <p>We will send a password-reset link to your email address.</p>
            </div>
        </div>

        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly"
                 class="auth-validation-summary"
                 role="alert"></div>

            <div class="auth-form-group">
                <label asp-for="Input.Email">Email address</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Input.Email"
                           class="auth-input"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Input.Email"
                      class="auth-field-validation"></span>
            </div>

            <button type="submit" class="auth-primary-btn">
                <i class="bi bi-send-fill"></i>
                Send reset link
            </button>

            <div class="auth-footer-links">
                <a asp-page="./Login">
                    <i class="bi bi-arrow-left"></i>
                    Back to login
                </a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
